      <trans-unit id="applications.filter.tier.high" datatype="html"><source>High probability leads</source><target>طلبات عالية الاحتمالية</target></trans-unit>
      <trans-unit id="applications.filter.tier.medium" datatype="html"><source>Medium probability</source><target>احتمالية متوسطة</target></trans-unit>
      <trans-unit id="applications.filter.tier.needs_coaching" datatype="html"><source>Needs coaching</source><target>يحتاج إلى متابعة</target></trans-unit>
