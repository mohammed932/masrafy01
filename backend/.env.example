# --- Database
DATABASE_URL=postgresql://masrafy:masrafy@localhost:5432/masrafy_dev?schema=public

# --- Redis
REDIS_URL=redis://localhost:6379

# --- JWT (admin API)
# Generate 32+ random bytes; e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_me_with_32_or_more_random_bytes_base64
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# --- Passwords
BCRYPT_COST=12

# --- HIBP (Pwned Passwords k-anonymity)
HIBP_BASE_URL=https://api.pwnedpasswords.com
HIBP_TIMEOUT_MS=1500

# --- Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Seed (bootstrap super_admin)
SEED_ADMIN_EMAIL=ops@masrafy.local
SEED_ADMIN_NAME=Operations
SEED_ADMIN_PASSWORD=ChangeMe_OnFirstLogin_!2026

# --- CORS (admin dashboard origins, comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Mobile API rate limits (Constitution v3.0.0 / Principle XV)
MOBILE_RATE_LIMIT_PER_CLIENT_PER_HOUR=30
MOBILE_RATE_LIMIT_PER_APPLICANT_PER_HOUR=5

# --- S3-compatible object storage (feature 005)
# Dev: MinIO at http://localhost:9000 with minioadmin / minioadmin
# Prod: AWS S3 — drop S3_ENDPOINT_URL (or set to https://s3.<region>.amazonaws.com),
#               set S3_FORCE_PATH_STYLE=false, supply IAM credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=masrafy-documents-development
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# --- Customer JWT (mobile customer-facing API — Constitution v1.8.0 / Principle XIII)
# Separate from admin JWT. Generate distinct secrets:
#   openssl rand -base64 48
CUSTOMER_JWT_ACCESS_SECRET=replace_me_distinct_from_admin_jwt_32_or_more_bytes
CUSTOMER_JWT_REFRESH_SECRET=replace_me_distinct_from_access_secret_32_or_more_bytes
CUSTOMER_JWT_ACCESS_TTL_SECONDS=900
CUSTOMER_JWT_REFRESH_TTL_SECONDS=2592000

# --- Feature 008 — Mobile Authentication & Two-Path Registration
# Admin-facing presigned read URL TTL for National-ID images (spec clarification Q2 = 1 hour).
ADMIN_DOCUMENT_PRESIGNED_READ_TTL_SECONDS=3600

# SMS gateway for customer OTP (registration / forgot-password only — NEVER login per FR-017).
# Dev: 'mock' writes the OTP to the Pino log with the code field redacted to ••••••.
# Prod: swap to the Egyptian SMS gateway (vendor is an ops decision; not in this spec).
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_FROM=+201000000000

# DEV-ONLY OTP override — every OTP issued resolves to this fixed 6-digit code
# instead of a random one (still bcrypt-hashed + stored normally). Guarded by
# NODE_ENV !== 'production' at runtime. Empty string = disabled (random codes).
OTP_DEV_FIXED_CODE=123456

# Google Sign-In — iOS + Android client IDs (comma-separated). Get them from Google Cloud Console.
# Both client IDs are accepted as `audience` by google-auth-library's verifyIdToken.
GOOGLE_OAUTH_CLIENT_IDS=ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com

# Apple Sign-In — your iOS app's bundle identifier (the `aud` claim on Apple ID tokens).
APPLE_BUNDLE_ID=com.masrafy.app

# --- App
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
