      <trans-unit id="applications.empty.subtitle" datatype="html"><source>Try a different filter or wait for new applications.</source><target>جرّب فلتراً آخر أو انتظر طلبات جديدة.</target></trans-unit>
      <trans-unit id="applications.col.probability" datatype="html"><source>Probability</source><target>الاحتمالية</target></trans-unit>
