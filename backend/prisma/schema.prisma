// Masrafy admin auth + user management.
// Constitution v1.0.0 Principles X, XI, XII apply.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum StaffRole {
  super_admin
  sales_manager
  sales_agent
  analyst
}

enum AttemptOutcome {
  SUCCESS
  WRONG_CREDENTIALS
  ACCOUNT_INACTIVE
  LOCKED_OUT
}

enum AuditEventType {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_TOKEN_REFRESHED
  AUTH_PASSWORD_CHANGED
  AUTH_PASSWORD_FORCED_CHANGE_COMPLETED
  ADMIN_USER_CREATED
  ADMIN_USER_UPDATED
  ADMIN_USER_DEACTIVATED
  ADMIN_USER_ROLE_CHANGED
  ADMIN_USER_PASSWORD_RESET
  BANK_PROGRAM_CREATED
  BANK_PROGRAM_UPDATED
  BANK_PROGRAM_TOGGLED
  BANK_PROGRAM_CLONED
  BANK_PROGRAM_DELETED
  BANK_PROGRAM_RATE_UPDATED
  BANK_PROGRAM_QUALITATIVE_REVIEW_DECIDED
  /// Feature 011 — a value-source marker was added or removed (FR-038). Also the
  /// source of `waitingSince` on the waiting list: "how long have we been waiting on
  /// this bank" is a question about WHEN the marker arrived, which only an event
  /// records (FR-036).
  BANK_PROGRAM_VALUE_SOURCE_CHANGED
  /// Feature 011 — a save introduced a team-estimated number on a LIVE program and
  /// switched it off in the same transaction (FR-035). Separate from an ordinary
  /// toggle so "why did this go dark?" names the paths and the editor.
  BANK_PROGRAM_DEACTIVATED_BY_ESTIMATE
  BANK_CREATED
  BANK_UPDATED
  BANK_TOGGLED
  BANK_DELETED
  BANK_LOGO_UPLOADED
  APPLICATION_CREATED
  APPLICATION_MATCHED
  APPLICATION_NO_MATCH
  APPLICATION_RATE_LIMITED
  MATCHING_ENGINE_RUN
  DATA_ERASURE_COMPLETED
  SCORING_ENGINE_VERSION_PROMOTED
  SCORING_WEIGHTS_SAVED
  APPLICATION_ACTIVITY_LOGGED
  DOCUMENT_UPLOADED
  APPLICATION_REASSIGNED
  MANAGER_ATTENTION_REQUESTED
  APPLICATION_LEAD_STATUS_CHANGED
  APPLICATION_USER_PROCEEDED
  PLATFORM_ENUMERATION_CREATED
  PLATFORM_ENUMERATION_UPDATED
  PLATFORM_ENUMERATION_DEACTIVATED
  PLATFORM_ENUMERATION_DEPRECATED
  /// A catalog entry was hard-DELETED (row gone, join rows cascaded). Distinct
  /// from DEPRECATED on purpose: deprecation is reversible and the row survives
  /// to explain old data, deletion leaves the audit event as the only remaining
  /// record that the key ever existed — so the payload carries the labels, not
  /// just the id.
  PLATFORM_ENUMERATION_DELETED
  CUSTOMER_SIGNED_UP
  CUSTOMER_LOGGED_IN
  CUSTOMER_LOGGED_OUT
  CUSTOMER_TOKEN_REFRESHED
  CUSTOMER_PASSWORD_CHANGED
  CUSTOMER_GUEST_APP_LINKED
  SUPPORT_REQUEST_CREATED
  SUPPORT_REQUEST_ASSIGNED
  SUPPORT_REQUEST_RESOLVED
  SUPPORT_CONFIG_UPDATED
  ONBOARDING_SCREEN_CREATED
  ONBOARDING_SCREEN_UPDATED
  ONBOARDING_SCREEN_DELETED
  ONBOARDING_SCREEN_REORDERED
  CATALOG_VIEWED
  QUESTIONNAIRE_STARTED
  OFFERS_VIEWED
  // --- Feature 008 (Constitution v1.8.0 / Principle XIII two-path registration) ---
  CUSTOMER_OTP_REQUESTED
  CUSTOMER_OTP_VERIFIED
  CUSTOMER_OTP_FAILED
  CUSTOMER_SIGNUP_PHONE_COMPLETED
  CUSTOMER_SIGNUP_SOCIAL_COMPLETED
  CUSTOMER_PROFILE_MOBILE_BOUND
  CUSTOMER_PROFILE_EMAIL_SET
  CUSTOMER_PROFILE_AGE_SET
  CUSTOMER_LOGIN_FAILED
  CUSTOMER_LOGIN_LOCKED
  CUSTOMER_TOKENS_REVOKED_OTHERS
  CUSTOMER_PASSWORD_RESET
  CUSTOMER_PROFILE_COMPLETED
  CUSTOMER_PROFILE_UPDATED
  APPLICATION_SUBMITTED
  // --- Admin-initiated customer account status (super_admin only) ---
  CUSTOMER_DEACTIVATED
  CUSTOMER_REACTIVATED
  // Admin revealed a customer PII document binary (National ID). Principle VI.
  CUSTOMER_DOCUMENT_REVEALED
  // --- RETIRED: no writer remains. Kept because `audit_event` rows are
  // append-only (Principle VI) and a Postgres enum value cannot be dropped in
  // place without recreating the type. Do not emit these.
  BANK_POLICY_UPDATED
  PROGRAM_CATALOG_DEFAULTS_UPDATED
}

enum SupportChannel {
  chat
  call
  whatsapp
  email
}

enum SupportStatus {
  open
  in_progress
  resolved
}

enum ApprovalTier {
  excellent
  good
  moderate
  low
  very_low
}

enum DecisionOutcome {
  approved
  rejected
  withdrawn
}

enum BankProgramType {
  income_proof
  income_surrogate
}

enum ApplicationStatus {
  draft
  matched
  no_match
  archived
  erased
}

// Sales-managed operational status of a lead (the applicant proceeded with an
// offer). Distinct from `ApplicationStatus` (engine matching outcome + data
// retention, system-set). Free-form transitions for MVP; default `pending`.
enum LeadStatus {
  pending
  in_progress
  done
  cancelled
}

enum ApplicationPriority {
  lowest_installment
  lowest_interest
  fastest_approval
  least_paperwork
}

// -----------------------------------------------------------------------------
// StaffAccount
// -----------------------------------------------------------------------------

model StaffAccount {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  email              String    @unique @db.VarChar(320)
  emailDisplay       String    @db.VarChar(320)
  name               String    @db.VarChar(120)
  passwordHash       String    @db.VarChar(72)
  role               StaffRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  lastLoginAt        DateTime? @db.Timestamptz(6)

  refreshTokens             RefreshToken[]
  signInAttempts            SignInAttempt[]
  auditEventsAsActor        AuditEvent[]           @relation("AuditEventActor")
  auditEventsAsTarget       AuditEvent[]           @relation("AuditEventTarget")
  bankProgramsCreated       BankProgram[]          @relation("BankProgramCreatedBy")
  bankProgramsUpdated       BankProgram[]          @relation("BankProgramUpdatedBy")
  banksCreated              Bank[]                 @relation("BankCreatedBy")
  banksUpdated              Bank[]                 @relation("BankUpdatedBy")
  scoringVersionActivations ScoringEngineVersion[] @relation("ScoringVersionActivator")
  documentsUploaded         Document[]             @relation("DocumentUploader")
  documentsVerified         Document[]             @relation("DocumentVerifier")

  @@index([isActive, role], name: "idx_staff_account_active_role")
  @@map("staff_account")
}

// -----------------------------------------------------------------------------
// RefreshToken
// -----------------------------------------------------------------------------

model RefreshToken {
  id            String    @id @default(cuid()) @db.VarChar(30)
  userId        String    @db.VarChar(30)
  tokenHash     String    @unique @db.Char(64)
  issuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  rotatedFromId String?   @db.VarChar(30)
  userAgent     String?   @db.VarChar(500)
  sourceIp      String?   @db.Inet

  user        StaffAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, revokedAt, expiresAt], name: "idx_refresh_token_user_active")
  @@map("refresh_token")
}

// -----------------------------------------------------------------------------
// SignInAttempt
// -----------------------------------------------------------------------------

model SignInAttempt {
  id             String         @id @default(cuid()) @db.VarChar(30)
  userId         String?        @db.VarChar(30)
  emailAttempted String         @db.VarChar(320)
  attemptedAt    DateTime       @default(now()) @db.Timestamptz(6)
  outcome        AttemptOutcome
  sourceIp       String         @db.Inet
  userAgent      String?        @db.VarChar(500)

  user StaffAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailAttempted, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_email_time")
  @@index([sourceIp, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_ip_time")
  @@index([userId, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_user_time")
  @@map("sign_in_attempt")
}

// -----------------------------------------------------------------------------
// AuditEvent
// -----------------------------------------------------------------------------

model AuditEvent {
  id            String         @id @default(cuid()) @db.VarChar(30)
  occurredAt    DateTime       @default(now()) @db.Timestamptz(6)
  actorId       String?        @db.VarChar(30)
  targetId      String?        @db.VarChar(30)
  bankProgramId String?        @db.VarChar(30)
  eventType     AuditEventType
  sourceIp      String?        @db.Inet
  payload       Json           @default("{}")

  actor       StaffAccount? @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  target      StaffAccount? @relation("AuditEventTarget", fields: [targetId], references: [id], onDelete: SetNull)
  bankProgram BankProgram?  @relation("BankProgramAuditEvents", fields: [bankProgramId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt(sort: Desc)], name: "idx_audit_event_actor_time")
  @@index([targetId, occurredAt(sort: Desc)], name: "idx_audit_event_target_time")
  @@index([bankProgramId, occurredAt(sort: Desc)], name: "idx_audit_event_bank_program_time")
  @@index([eventType, occurredAt(sort: Desc)], name: "idx_audit_event_type_time")
  @@map("audit_event")
}

// -----------------------------------------------------------------------------
// BankProgram (feature 002)
// -----------------------------------------------------------------------------

model BankProgram {
  id                String          @id @default(cuid()) @db.VarChar(30)
  programCode       String          @unique @db.VarChar(32)
  /// @deprecated — backfilled from `bank` relation; drop after v0.2.x release.
  bankName          String          @db.VarChar(80)
  bankId            String?         @db.VarChar(30)
  bank              Bank?           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  friendlyName      String          @db.VarChar(120)
  friendlyNameAr    String?         @db.VarChar(120)
  /// Predefined program-name catalog key (`platform_enumeration` where
  /// `type = 'program_name'`). Nullable for legacy rows only — REQUIRED on every
  /// create/update through the API, which rejects unknown keys with
  /// `PROGRAM_NAME_KEY_UNKNOWN`. No FK: the catalog's unique key is the composite
  /// (type, key), so validation lives in the service layer like every other
  /// enumeration-backed field on this model.
  programNameKey    String?         @db.VarChar(64)
  programType       BankProgramType
  productCategory   String          @db.VarChar(64)
  active            Boolean         @default(true)
  isShariaCompliant Boolean         @default(false)
  version           Int             @default(1)
  operatorNotes     String?         @db.VarChar(4000)
  operatorTips      String[]        @db.VarChar(500)
  requiredDocuments String[]        @db.VarChar(80)

  // JSONB sub-configurations (research.md R1). Hydrated to typed values in repo layer.
  tenor               Json
  loanLimits          Json
  pricing             Json
  eligibility         Json
  performanceCriteria Json?
  incomeAssumption    Json
  fees                Json

  /// Feature 011 — sparse map of config dot-path → 'team_estimated'
  /// (`{"pricing.baseRatePercent": "team_estimated"}`).
  ///
  /// Only the NON-default state is stored: an ABSENT path is bank-stated. That is
  /// what lets every pre-existing program stay live on deploy (FR-037) — the
  /// default `{}` marks nothing estimated, so nothing goes dark. Storing both
  /// states would need a backfill over every numeric path of every program, and
  /// would make "a new field nobody has marked yet" indistinguishable from
  /// "estimated".
  ///
  /// Read on activation: a non-empty map refuses going live (FR-033). Never read
  /// by the matching engine — it is provenance about the configuration, not part
  /// of it.
  valueSources Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  createdBy String   @db.VarChar(30)
  updatedBy String   @db.VarChar(30)

  createdByStaff    StaffAccount       @relation("BankProgramCreatedBy", fields: [createdBy], references: [id])
  updatedByStaff    StaffAccount       @relation("BankProgramUpdatedBy", fields: [updatedBy], references: [id])
  auditEvents       AuditEvent[]       @relation("BankProgramAuditEvents")
  // Feature 00X — approval-scoring weights (admin maker-checker, Principle V v4.1.0).
  scoringWeightSets ScoringWeightSet[] @relation("BankProgramScoringWeightSets")

  @@index([active], name: "idx_bank_program_active")
  @@index([bankName], name: "idx_bank_program_bank_name")
  @@index([bankId], name: "idx_bank_program_bank_id")
  @@index([productCategory], name: "idx_bank_program_product_category")
  @@index([isShariaCompliant], name: "idx_bank_program_sharia")
  @@index([programNameKey], name: "idx_bank_program_program_name_key")
  @@map("bank_program")
}

// -----------------------------------------------------------------------------
// Bank — issuer entity managed by super_admin. BankPrograms link to Bank via FK.
// -----------------------------------------------------------------------------

model Bank {
  id           String   @id @default(cuid()) @db.VarChar(30)
  nameArabic   String   @db.VarChar(120)
  nameEnglish  String   @unique @db.VarChar(120)
  logoS3Key    String?  @db.VarChar(255)
  websiteUrl   String?  @db.VarChar(500)
  isActive     Boolean  @default(true)
  /// Phase-1 partner-bank flag. When true, the matching engine's `rankOffers`
  /// uses this as the final tiebreaker — identical primary-sort-key offers
  /// from featured banks rank first. Does NOT change eligibility or pricing.
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  notes        String?  @db.VarChar(2000)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  createdBy    String   @db.VarChar(30)
  updatedBy    String   @db.VarChar(30)

  createdByStaff StaffAccount  @relation("BankCreatedBy", fields: [createdBy], references: [id])
  updatedByStaff StaffAccount  @relation("BankUpdatedBy", fields: [updatedBy], references: [id])
  programs       BankProgram[]

  @@index([isActive, displayOrder], name: "idx_bank_active_order")
  @@index([isFeatured, isActive], name: "idx_bank_featured_active")
  @@map("bank")
}

// -----------------------------------------------------------------------------
// Application (feature 003 — matching engine)
// -----------------------------------------------------------------------------

model Application {
  id                      String              @id @default(cuid()) @db.VarChar(30)
  applicantUserId         String              @db.VarChar(30)
  submissionCorrelationId String              @db.VarChar(36)
  idempotencyKey          String?             @db.VarChar(128)
  payloadHash             String?             @db.Char(64)
  status                  ApplicationStatus   @default(draft)
  // Sales pipeline status — admin-managed, separate from engine `status`.
  leadStatus              LeadStatus          @default(pending)
  priority                ApplicationPriority
  requestedAmountEGP      Decimal             @db.Decimal(13, 2)
  preferredTenorMonths    Int
  loanPurpose             String              @db.VarChar(64)
  // Feature 00X — dynamic questionnaire: chosen category + the published
  // questionnaire version answered (snapshot reproducibility). Nullable until
  // the dynamic-questionnaire apply path replaces the legacy fixed-DTO path.
  category                LoanCategory?
  /// Catalog program-name archetype the applicant picked on top of the
  /// category (`platform_enumeration` where `type = 'program_name'`). The pair
  /// (category, programNameKey) is what narrowed the programs this application
  /// was matched against, so it is persisted: without it a stored application
  /// cannot explain why a program the customer can see in the catalog produced
  /// no offer. Nullable — legacy rows and any category-less submit carry none,
  /// and a null means "every program in the category", not "unknown".
  /// No FK, same posture as `bank_program.programNameKey`: the catalog's unique
  /// key is the composite (type, key), so validation lives in the service.
  programNameKey          String?             @db.VarChar(64)
  /// The income basis the applicant said they can prove, which narrowed the
  /// program set alongside the pair above. Persisted for the same reason:
  /// without it a stored application cannot explain why a program the customer
  /// can see in the catalog produced no offer. Nullable — every client built
  /// before the income-type step sends none, and a null means "both bases",
  /// not "unknown". Unlike `bank_program.programType` (NOT NULL) this is a
  /// REQUEST field, so the nullability is about client versions, not about
  /// programs being unclassified.
  programType             BankProgramType?
  questionnaireVersionId  String?             @db.VarChar(30)
  age                     Int
  applicantProfile        Json
  summary                 Json
  noMatchSummary          Json?
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  archivedAt              DateTime?           @db.Timestamptz(6)
  erasedAt                DateTime?           @db.Timestamptz(6)
  coldTierKey             String?             @db.VarChar(256)
  engineDurationMs        Int?
  programsCheckedCount    Int                 @default(0)
  eligibleProgramsCount   Int                 @default(0)

  // Feature 008 — user-intent gate: admin dashboard surfaces only applications
  // where the applicant explicitly selected a matched offer and proceeded.
  userSelectedBankOfferId String?   @db.VarChar(30)
  userProceededAt         DateTime? @db.Timestamptz(6)

  bankOffers            BankOffer[]           @relation("ApplicationBankOffers")
  userSelectedBankOffer BankOffer?            @relation("ApplicationUserSelectedOffer", fields: [userSelectedBankOfferId], references: [id], onDelete: SetNull)
  documents             Document[]            @relation("ApplicationDocuments")
  applicantCustomer     CustomerAccount       @relation("CustomerApplications", fields: [applicantUserId], references: [id], onDelete: Restrict)
  questionnaireAnswers  QuestionnaireAnswer[] @relation("QuestionnaireApplication")
  dynamicAnswers        ApplicationAnswer[]   @relation("ApplicationDynamicAnswers")

  @@unique([applicantUserId, idempotencyKey], name: "idx_application_idempotency")
  @@index([loanPurpose], name: "idx_application_purpose")
  @@index([leadStatus], name: "idx_application_lead_status")
  @@index([applicantUserId, createdAt(sort: Desc)], name: "idx_application_customer_created")
  @@index([userProceededAt(sort: Desc)], name: "idx_application_user_proceeded_at")
  @@map("application")
}

// -----------------------------------------------------------------------------
// BankOffer (feature 003 — immutable snapshot)
// -----------------------------------------------------------------------------

model BankOffer {
  id                         String       @id @default(cuid()) @db.VarChar(30)
  applicationId              String       @db.VarChar(30)
  programCode                String       @db.VarChar(32)
  programVersion             Int
  bankName                   String       @db.VarChar(80)
  programFriendlyName        String       @db.VarChar(120)
  /// Snapshot of the owning bank's `isFeatured` at match time (Constitution
  /// Principle I — BankOffer is immutable; the partner-bank flag is frozen
  /// here so a bank toggling its featured state later doesn't rewrite
  /// history). Surfaced to mobile so the FEATURED chip never goes stale.
  bankIsFeatured             Boolean      @default(false)
  /// Snapshot of the program's Sharia-compliance flag at match time. Frozen on
  /// the offer for the same reason as `bankIsFeatured` (Principle I — BankOffer
  /// is immutable): a program later re-flagged must not rewrite past offers.
  isShariaCompliant          Boolean      @default(false)
  effectiveRatePercent       Decimal      @db.Decimal(7, 4)
  monthlyInstallmentEGP      Decimal      @db.Decimal(13, 2)
  requestedLoanAmountEGP     Decimal      @db.Decimal(13, 2)
  effectiveLoanAmountEGP     Decimal      @db.Decimal(13, 2)
  requestedTenorMonths       Int
  effectiveTenorMonths       Int
  feesBreakdown              Json
  approvalProbabilityPercent Decimal      @db.Decimal(5, 2)
  approvalScore              Int
  approvalTier               ApprovalTier
  approvalFactors            Json
  /// True when the program had no ACTIVE ScoringWeightSet at match time, so the
  /// score is 0 for want of configuration rather than for want of a fit. Must be
  /// persisted, not derived: configuring the program later would silently
  /// rewrite the meaning of an immutable offer (Principle I).
  approvalUsedDefault        Boolean      @default(false)
  engineVersion              String       @db.VarChar(32)
  requiredDocuments          String[]     @db.VarChar(80)
  matchReasons               String[]     @db.VarChar(80)
  cascadeTrace               Json
  qualitativeReviewBadge     Boolean      @default(false)
  selfDeclared               Boolean      @default(false)
  /// The applicant's borrowing ceiling at this program, frozen at match time:
  /// income × dbrCapPercent ÷ 100 − obligations, present-valued over the tenor.
  /// Independent of what was requested — compare with `effectiveLoanAmountEGP`
  /// to tell "this is your limit" from "you asked for less than you could have".
  maxLoanAvailableEGP        Decimal?     @db.Decimal(13, 2)
  /// (installment + existing obligations) ÷ income × 100 for THIS offer, and the
  /// cap it was measured against (scalar or the resolved band). Frozen with the
  /// offer so a later policy change cannot rewrite why an amount was what it was.
  dbrPercent                 Decimal?     @db.Decimal(6, 2)
  dbrCapPercent              Decimal?     @db.Decimal(7, 4)
  /// Feature 011 — WHICH income the quote actually ran on:
  /// `declared` · `surrogate` · `declared_over_surrogate` · `surrogate_over_declared`.
  ///
  /// Frozen at match time for the same reason as `approvalUsedDefault` above:
  /// editing the program's income rule later must not rewrite the meaning of an
  /// immutable offer (Principle I / A6). Deriving it at read time would rewrite
  /// history every time an admin fixed a table row.
  ///
  /// `null` means "recorded before provenance existed" — NOT `declared`. Readers
  /// must render the absence rather than assume a value.
  incomeOrigin               String?      @db.VarChar(32)
  /// The surrogate method that produced the income, when one did — the strategy
  /// token (`byMilitaryGrade`, …). `null` on a declared-income offer and on every
  /// offer predating this column.
  incomeSurrogateStrategy    String?      @db.VarChar(32)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  erasedAt                   DateTime?    @db.Timestamptz(6)

  application            Application        @relation("ApplicationBankOffers", fields: [applicationId], references: [id], onDelete: Cascade)
  selectedByApplications Application[]      @relation("ApplicationUserSelectedOffer")
  decision               BankOfferDecision? @relation("BankOfferDecisionFor")
  savedBy                SavedOffer[]       @relation("BankOfferSavedBy")

  @@index([applicationId], name: "idx_bank_offer_application")
  @@index([programCode, createdAt(sort: Desc)], name: "idx_bank_offer_program_created")
  @@index([approvalScore], name: "idx_bank_offer_approval_score")
  @@index([engineVersion], name: "idx_bank_offer_engine_version")
  @@map("bank_offer")
}

// -----------------------------------------------------------------------------
// SavedOffer — a customer bookmarking a matched BankOffer ("Saved Offers"
// screen, Figma 4088-153). Pure link row: a customer ↔ an immutable BankOffer.
// All display fields are read from the related BankOffer (and its parent
// Application for the loan category) — nothing is duplicated here, so the
// BankOffer snapshot stays the single source of truth (Principle I).
// -----------------------------------------------------------------------------

model SavedOffer {
  id          String   @id @default(cuid()) @db.VarChar(30)
  customerId  String   @db.VarChar(30)
  bankOfferId String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  customer  CustomerAccount @relation("CustomerSavedOffers", fields: [customerId], references: [id], onDelete: Cascade)
  bankOffer BankOffer       @relation("BankOfferSavedBy", fields: [bankOfferId], references: [id], onDelete: Cascade)

  @@unique([customerId, bankOfferId], name: "idx_saved_offer_customer_offer")
  @@index([customerId, createdAt(sort: Desc)], name: "idx_saved_offer_customer_created")
  @@map("saved_offer")
}

// -----------------------------------------------------------------------------
// ScoringEngineVersion (feature 004) — registry of past + active engine versions
// -----------------------------------------------------------------------------

model ScoringEngineVersion {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  version            String    @unique @db.VarChar(32)
  description        String?   @db.VarChar(1000)
  weightsConfig      Json
  activatedAt        DateTime  @default(now()) @db.Timestamptz(6)
  deactivatedAt      DateTime? @db.Timestamptz(6)
  activatedByStaffId String?   @db.VarChar(30)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)

  activatedByStaff StaffAccount? @relation("ScoringVersionActivator", fields: [activatedByStaffId], references: [id], onDelete: SetNull)

  @@index([activatedAt(sort: Desc)], name: "idx_scoring_engine_version_activated")
  @@map("scoring_engine_version")
}

// -----------------------------------------------------------------------------
// BankOfferDecision (feature 004 placeholder — populated by future feed)
// -----------------------------------------------------------------------------

model BankOfferDecision {
  id                String          @id @default(cuid()) @db.VarChar(30)
  bankOfferId       String          @unique @db.VarChar(30)
  outcome           DecisionOutcome
  recordedAt        DateTime        @default(now()) @db.Timestamptz(6)
  decisionLatencyMs Int?

  bankOffer BankOffer @relation("BankOfferDecisionFor", fields: [bankOfferId], references: [id], onDelete: Cascade)

  @@index([recordedAt(sort: Desc)], name: "idx_bank_offer_decision_recorded")
  @@index([outcome], name: "idx_bank_offer_decision_outcome")
  @@map("bank_offer_decision")
}

// -----------------------------------------------------------------------------
// Document (feature 005) — file attachment metadata. Binary lives in S3.
// -----------------------------------------------------------------------------

model Document {
  id                   String    @id @default(cuid()) @db.VarChar(30)
  applicationId        String?   @db.VarChar(30)
  customerId           String?   @db.VarChar(30)
  documentType         String    @db.VarChar(64)
  s3Key                String    @unique @db.VarChar(256)
  status               String    @db.VarChar(24)
  uploadedByContext    String    @db.VarChar(24)
  uploadedBySource     String    @db.VarChar(24)
  uploadedByStaffId    String?   @db.VarChar(30)
  uploadedByCustomerId String?   @db.VarChar(30)
  originalFilename     String    @db.VarChar(255)
  mimeType             String    @db.VarChar(48)
  sizeBytes            Int
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  verifiedAt           DateTime? @db.Timestamptz(6)
  verifiedByStaffId    String?   @db.VarChar(30)
  erasedAt             DateTime? @db.Timestamptz(6)

  application        Application?     @relation("ApplicationDocuments", fields: [applicationId], references: [id], onDelete: Cascade)
  customer           CustomerAccount? @relation("DocumentCustomerOwner", fields: [customerId], references: [id], onDelete: Cascade)
  uploadedByStaff    StaffAccount?    @relation("DocumentUploader", fields: [uploadedByStaffId], references: [id], onDelete: SetNull)
  uploadedByCustomer CustomerAccount? @relation("DocumentCustomerUploader", fields: [uploadedByCustomerId], references: [id], onDelete: SetNull)
  verifiedByStaff    StaffAccount?    @relation("DocumentVerifier", fields: [verifiedByStaffId], references: [id], onDelete: SetNull)

  @@index([applicationId, documentType, status], name: "idx_document_application_type_status")
  @@index([customerId, documentType, status], name: "idx_document_customer_type_status")
  @@index([uploadedByStaffId, createdAt(sort: Desc)], name: "idx_document_uploader_created")
  @@index([uploadedByCustomerId, createdAt(sort: Desc)], name: "idx_document_customer_uploader_created")
  @@map("document")
}

// -----------------------------------------------------------------------------
// PlatformEnumeration (feature 006) — operator-managed dropdown registry.
// Replaces the in-memory stub from feature 002 (research R4).
// Lifecycle: active=true is the only state shown in pickers; deprecatedAt
// flags a key that historical rows may still reference but new writes
// should reject. systemOnly=true blocks all CRUD except label edits.
// -----------------------------------------------------------------------------

model PlatformEnumeration {
  id              String    @id @default(cuid()) @db.VarChar(30)
  type            String    @db.VarChar(48)
  key             String    @db.VarChar(64)
  labelAr         String    @db.VarChar(160)
  labelEn         String    @db.VarChar(160)
  active          Boolean   @default(true)
  deprecatedAt    DateTime? @db.Timestamptz(6)
  systemOnly      Boolean   @default(false)
  parentKey       String?   @db.VarChar(64)
  sortOrder       Int       @default(0)
  /// `surrogate_fact` only — the question whose ANSWER is this fact.
  ///
  /// The fact registry used to be a code constant
  /// (`matching/pipeline/surrogate-fact-bindings.ts`, four entries), which meant a
  /// bank that works income out from a fact nobody had foreseen — a taxi licence
  /// class, a clinic's patient count — needed a release. The four facts are now
  /// rows of `type = 'surrogate_fact'` and an operator adds a fifth on Manage
  /// values by picking the question that answers it.
  ///
  /// A COLUMN HERE, NOT A FIELD ON `question` — A33 forbids a scoring or
  /// profile-mapping field on `Question`, and this is the same binding
  /// `question_loan_category` is: it says what the REGISTRY reads, not what the
  /// question is. The question stays pure content.
  ///
  /// `ON DELETE SET NULL`, deliberately not cascade: a fact whose question left the
  /// pool is a fact that still has bank tables written against it, and the operator
  /// must see it unbound (publish warns `missing_or_inactive`) rather than watch the
  /// fact vanish and take every table's meaning with it.
  ///
  /// Only SINGLE_SELECT and NUMERIC questions may be bound (service-enforced): the
  /// first gives a key table, the second gives bands, and nothing else is a figure a
  /// bank can look an income up against.
  boundQuestionId String?   @db.VarChar(30)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  createdBy       String?   @db.VarChar(30)
  updatedBy       String?   @db.VarChar(30)

  loanCategories PlatformEnumerationLoanCategory[] @relation("PlatformEnumerationLoanCategories")
  questions      PlatformEnumerationQuestion[]     @relation("PlatformEnumerationQuestions")
  boundQuestion  Question?                         @relation("QuestionSurrogateFactBindings", fields: [boundQuestionId], references: [id], onDelete: SetNull)

  @@unique([type, key], name: "idx_platform_enumeration_type_key")
  @@index([type, active, sortOrder], name: "idx_platform_enumeration_type_active_sort")
  @@index([type, parentKey], name: "idx_platform_enumeration_type_parent")
  @@index([boundQuestionId], name: "idx_platform_enumeration_bound_question")
  @@map("platform_enumeration")
}

/// Which loan categories a catalog entry may be OFFERED under.
///
/// A join row, not a column: one `program_name` archetype ("Pharmacy") serves
/// several categories, and the `categories[]` array this replaces
/// (`20260802090000_drop_program_name_categories`) could be neither indexed nor
/// audited per pair, and shipped with no backfill — so narrowing it silently
/// hid valid picks in the bank-program builder. Here the set is AUTHORITATIVE:
/// an entry with no rows is "parked" (offerable nowhere), and bank-program
/// create/update/duplicate reject an unassigned (programNameKey,
/// productCategory) pair.
///
/// Generic by shape, meaningful only for the types in
/// `CATEGORISED_ENUMERATION_TYPES`. The service layer — not a CHECK constraint —
/// keeps a `governorate` row from acquiring a loan category, the same posture
/// `bank_program.programNameKey` already takes (no FK, validated in the service).
///
/// Orthogonal to `parentKey`, which stays NULL for `program_name`
/// (`20260807090000_clear_program_name_parent_key`): that column is the
/// registry's generic single-parent SCOPE, this is a many-to-many ASSIGNMENT.
/// No income-basis columns here (dropped in `20260816090000_drop_program_name_income_basis`).
/// v16.1.0 stored `payslip` / `noPayslip` per pair and the API refused a program whose
/// own basis was not ticked. That made the catalog a SECOND place to state one thing the
/// bank already states on its program (`bank_program.programType`), and the two could
/// disagree — with the catalog winning, so a bank's own choice was refused by a tick set
/// on another screen. The program is now the only authority; the catalog SHOWS what banks
/// picked, counted from `bank_program`, and enforces nothing.
model PlatformEnumerationLoanCategory {
  enumerationId String       @db.VarChar(30)
  category      LoanCategory
  /// How income is proved when this name is sold under this category — the
  /// INCOME BASIS, stored per (name, category) pair.
  ///
  /// Two booleans rather than one enum because a name legitimately carries BOTH:
  /// one bank sells "Doctor Loans" against a payslip while another works the
  /// income out from years in practice, and v16.0.0 deleted the `fast` category
  /// precisely because that pair is one product, not two. A single-valued column
  /// would force the second bank to duplicate the catalog entry.
  ///
  /// This is the operator's INTENT for the name — what the catalog says the name is
  /// for. It does NOT refuse a bank program: `bank_program.programType` is the only
  /// authority on how one bank actually sells it, and the catalog reports that split
  /// separately (`countProgramNameUsage.byCategory`). The two answer different
  /// questions and are allowed to disagree — a name marked payslip-only that a bank
  /// then sells without one is a signal to look, not a save to block.
  ///
  /// Both false is meaningless (a pair offerable under no basis is unsellable) and
  /// is rejected in the service, the same posture this table already takes for
  /// "only `program_name` may be categorised".
  payslip       Boolean      @default(true)
  noPayslip     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  enumeration PlatformEnumeration @relation("PlatformEnumerationLoanCategories", fields: [enumerationId], references: [id], onDelete: Cascade)

  @@id([enumerationId, category], name: "pk_platform_enumeration_loan_category")
  @@index([category], name: "idx_platform_enumeration_loan_category_category")
  @@map("platform_enumeration_loan_category")
}

/// Which questions a catalog program name SUGGESTS scoring on — the archetype's
/// house opinion about what matters for that product ("New Car" cares about the
/// car instalment; "Working Capital" cares about company age).
///
/// A TEMPLATE, READ BY NOTHING AT RUNTIME. `ScoringWeightSet.weights.questionWeights`
/// remains the sole authority on what a bank program actually scores, and
/// `ScoringService.saveWeights` never consults this table. All this does is
/// pre-tick step 1 of the per-program scoring wizard, where the admin then sets
/// the weights — the archetype says WHICH questions, each bank says HOW MUCH.
/// Do not "complete" the feature by wiring it into save validation: that would
/// make a catalog edit retroactively invalidate weight sets banks already saved.
///
/// No weights here, deliberately. Two banks offering the same archetype price it
/// differently — that difference is the whole marketplace — so a shared weight
/// would be a value with no owner.
///
/// Keyed by `questionId`, not `code`, so the board can tell "this question left
/// the pool" (row cascaded away) from "this question is out of scope" (row still
/// here, flagged). A dangling code column cannot express that difference, and the
/// two have different fixes.
///
/// PER LOAN CATEGORY. One archetype serves several categories ("Pharmacy" sells
/// as personal, car and business) and each of those products cares about
/// different things, so the suggestion is a fact about the (name, category) PAIR,
/// not about the name. A flat name→question set could not say "Doctor Loans
/// scores on `monthly_income` as a personal loan but not as a business one",
/// because the row is the same row. The bank program that consumes this seed
/// always knows its own `productCategory`, so there is always exactly one set to
/// read.
///
/// The category is NOT validated against `platform_enumeration_loan_category`
/// here (nor by the service). A pick under a category the name is not currently
/// offered under is kept and flagged, never pruned — same anti-prune posture as
/// an out-of-scope question code. Re-assign the category and the picks are still
/// there.
model PlatformEnumerationQuestion {
  enumerationId String       @db.VarChar(30)
  category      LoanCategory
  questionId    String       @db.VarChar(30)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  enumeration PlatformEnumeration @relation("PlatformEnumerationQuestions", fields: [enumerationId], references: [id], onDelete: Cascade)
  question    Question            @relation("QuestionPlatformEnumerations", fields: [questionId], references: [id], onDelete: Cascade)

  /// `enumerationId` leads so the board's read (one name, every category) is a
  /// prefix scan, and the per-tab write (`deleteMany` on name + category) is a
  /// two-column prefix rather than a filtered scan of the name's whole template.
  @@id([enumerationId, category, questionId], name: "pk_platform_enumeration_question")
  @@index([questionId], name: "idx_platform_enumeration_question_question")
  @@map("platform_enumeration_question")
}

// -----------------------------------------------------------------------------
// CustomerAccount (v1.7.0 / Principle XIII customer-facing mobile auth).
// Distinct from StaffAccount — end-users of the Flutter app sign up with
// phone (unique) + password and receive a customer JWT.
// -----------------------------------------------------------------------------

// Feature 008 — Two-Path Registration (Constitution v1.8.0 / Principle XIII).
// `registrationPath` distinguishes upfront-PHONE customers (fully populated at
// signup) from lite-SOCIAL customers (provider sign-in; mobile + age completed
// via the loan-request Complete-Profile flow). `passwordHash` is nullable so
// SOCIAL customers (who authenticate via Google) need not carry one.
// `mobileVerifiedAt` flips non-null IFF `phone` is OTP-verified — once set,
// both fields are immutable (enforced by repository, not the DB). `age` is
// nullable for in-flight SOCIAL customers; set immutably on first successful
// loan submission.
enum RegistrationPath {
  PHONE
  SOCIAL
}

// Constitution v11.0.0 — Google is the only social provider. `APPLE` was
// dropped from this enum by `google_only_social_provider`; the enum type itself
// is kept single-valued because it keys two tables and is where a future
// provider would be added.
enum SocialProvider {
  GOOGLE
}

enum OtpPurpose {
  SIGNUP
  PROFILE_MOBILE
  FORGOT_PASSWORD
  MOBILE_CHANGE
}

model CustomerAccount {
  id                   String           @id @default(cuid()) @db.VarChar(30)
  registrationPath     RegistrationPath @default(PHONE)
  phone                String?          @unique @db.VarChar(20)
  mobileVerifiedAt     DateTime?        @db.Timestamptz(6)
  email                String?          @unique @db.VarChar(320)
  firstName            String           @db.VarChar(60)
  lastName             String           @db.VarChar(60)
  nameSplitNeedsReview Boolean          @default(false)
  locale               String           @default("ar-EG") @db.VarChar(8)
  passwordHash         String?          @db.VarChar(72)
  birthday             DateTime?        @db.Date
  profilePhotoKey      String?          @db.VarChar(256)
  nationalIdHash       String?          @db.Char(64)
  governorate          String?          @db.VarChar(60)
  city                 String?          @db.VarChar(120)
  address              String?          @db.VarChar(255)
  isVerified           Boolean          @default(false)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)
  lastLoginAt          DateTime?        @db.Timestamptz(6)

  refreshTokens     CustomerRefreshToken[]
  applications      Application[]          @relation("CustomerApplications")
  uploadedDocuments Document[]             @relation("DocumentCustomerUploader")
  idDocuments       Document[]             @relation("DocumentCustomerOwner")
  supportRequests   SupportRequest[]       @relation("SupportRequestCustomer")
  providers         CustomerProvider[]
  passwordResets    PasswordResetToken[]
  questionnaires    QuestionnaireAnswer[]
  savedOffers       SavedOffer[]           @relation("CustomerSavedOffers")

  // Postgres UNIQUE allows multiple NULLs by default, so `phone @unique`
  // works fine for SOCIAL customers whose phone is still null pending the
  // Complete-Profile flow.
  @@index([isActive, createdAt(sort: Desc)], name: "idx_customer_account_active_created")
  @@index([registrationPath], name: "idx_customer_account_registration_path")
  @@map("customer_account")
}

model CustomerRefreshToken {
  id            String    @id @default(cuid()) @db.VarChar(30)
  customerId    String    @db.VarChar(30)
  tokenHash     String    @unique @db.Char(64)
  issuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  rotatedFromId String?   @db.VarChar(30)
  userAgent     String?   @db.VarChar(500)
  sourceIp      String?   @db.Inet

  customer    CustomerAccount        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rotatedFrom CustomerRefreshToken?  @relation("CustomerRefreshTokenRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   CustomerRefreshToken[] @relation("CustomerRefreshTokenRotation")

  @@index([customerId, revokedAt, expiresAt], name: "idx_customer_refresh_token_active")
  @@map("customer_refresh_token")
}

// -----------------------------------------------------------------------------
// Feature 008 — Two-Path Registration tables (Constitution v1.8.0 / Principle XIII).
// -----------------------------------------------------------------------------

// One row per (customer, provider) link. Provider+providerUserId is the unique
// natural key — the Google subject ID. Email is captured at link time so a
// provider that later withholds it cannot orphan the account.
model CustomerProvider {
  id             String         @id @default(cuid()) @db.VarChar(30)
  customerId     String         @db.VarChar(30)
  provider       SocialProvider
  providerUserId String         @db.VarChar(255)
  email          String?        @db.VarChar(320)
  linkedAt       DateTime       @default(now()) @db.Timestamptz(6)

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([customerId], name: "idx_customer_provider_customer")
  @@map("customer_provider")
}

// OTP challenges. `customerId` is null for SIGNUP / FORGOT_PASSWORD (pre-
// customer-link) and set for PROFILE_MOBILE (SOCIAL Complete-Profile mobile
// binding). codeHash is bcrypt cost 10. Never logged.
model OtpChallenge {
  id           String     @id @default(cuid()) @db.VarChar(30)
  customerId   String?    @db.VarChar(30)
  phone        String     @db.VarChar(20)
  purpose      OtpPurpose
  codeHash     String     @db.VarChar(72)
  attemptsLeft Int        @default(5)
  expiresAt    DateTime   @db.Timestamptz(6)
  consumedAt   DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, expiresAt], name: "idx_otp_challenge_active")
  @@index([customerId, expiresAt], name: "idx_otp_challenge_customer")
  @@map("otp_challenge")
}

// Single-use, 15-min-TTL bearer proving an OTP-verified phone in the PHONE
// signup flow. Consumed by /auth/signup/phone/complete. SOCIAL Complete-
// Profile uses the customer's JWT instead (the customer record already exists).
model VerifiedMobileToken {
  id         String    @id @default(cuid()) @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  phone      String    @db.VarChar(20)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, expiresAt], name: "idx_verified_mobile_token_phone")
  @@map("verified_mobile_token")
}

// Short-lived (15 min) wrapper around a successful Google ID-token
// verification. Consumed by /auth/social/login (returning customer) or the
// social-signup transaction (new customer + CustomerProvider link).
model SocialSession {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  provider           SocialProvider
  providerUserId     String         @db.VarChar(255)
  email              String?        @db.VarChar(320)
  fullName           String?        @db.VarChar(120)
  resolvedCustomerId String?        @db.VarChar(30)
  expiresAt          DateTime       @db.Timestamptz(6)
  consumedAt         DateTime?      @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)

  @@index([provider, providerUserId], name: "idx_social_session_subject")
  @@map("social_session")
}

// Single-use, 15-min-TTL token issued after a successful forgot-password OTP.
// PHONE customers only. Consumed by /auth/password/reset.
model PasswordResetToken {
  id         String    @id @default(cuid()) @db.VarChar(30)
  customerId String    @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt], name: "idx_password_reset_token_active")
  @@map("password_reset_token")
}

// Server-side persisted questionnaire draft per customer. Survives across
// devices (FR-007). One active "draft" row per customer; on loan-application
// submit, `applicationId` is set to freeze the snapshot at submission time.
// (Field set kept narrow here — additional questionnaire fields will be added
// when the existing questionnaire feature is migrated server-side.)
model QuestionnaireAnswer {
  id            String   @id @default(cuid()) @db.VarChar(30)
  customerId    String   @db.VarChar(30)
  applicationId String?  @db.VarChar(30)
  payloadJson   Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  customer    CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application Application?    @relation("QuestionnaireApplication", fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_questionnaire_answer_customer")
  @@index([applicationId], name: "idx_questionnaire_answer_application")
  @@map("questionnaire_answer")
}

// -----------------------------------------------------------------------------
// Support (PR #5) — singleton config + customer-initiated requests.
// -----------------------------------------------------------------------------

model SupportConfig {
  id          String   @id @default("singleton") @db.VarChar(16)
  phone       String   @db.VarChar(40)
  email       String   @db.VarChar(320)
  whatsappUrl String   @db.VarChar(500)
  hoursAr     String   @db.VarChar(200)
  hoursEn     String   @db.VarChar(200)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedBy   String?  @db.VarChar(30)

  @@map("support_config")
}

model SupportRequest {
  id              String         @id @default(cuid()) @db.VarChar(30)
  applicationId   String?        @db.VarChar(30)
  customerId      String?        @db.VarChar(30)
  channel         SupportChannel
  note            String?        @db.VarChar(2000)
  status          SupportStatus  @default(open)
  assignedStaffId String?        @db.VarChar(30)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?      @db.Timestamptz(6)

  customer CustomerAccount? @relation("SupportRequestCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)], name: "idx_support_request_status_created")
  @@index([assignedStaffId, status], name: "idx_support_request_agent_status")
  @@index([applicationId], name: "idx_support_request_application")
  @@map("support_request")
}

// -----------------------------------------------------------------------------
// OnboardingScreen (PR #6) — mobile first-launch screens (2-3 items).
// Admin-editable; mobile reads via HMAC.
// -----------------------------------------------------------------------------

model OnboardingScreen {
  id         String   @id @default(cuid()) @db.VarChar(30)
  order      Int      @unique
  titleAr    String   @db.VarChar(200)
  titleEn    String   @db.VarChar(200)
  bodyAr     String   @db.VarChar(2000)
  bodyEn     String   @db.VarChar(2000)
  imageS3Key String?  @db.VarChar(255)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  updatedBy  String?  @db.VarChar(30)

  @@index([active, order], name: "idx_onboarding_screen_active_order")
  @@map("onboarding_screen")
}

// -----------------------------------------------------------------------------
// Feature 00X — Dynamic Questionnaire & Matching (Constitution V v4.1.0).
// Questions/options/branching/ordering + per-bank scoring weights are
// admin-editable DATA; formula/tiers/COMPUTED factors stay in code.
// LoanCategory values are lowercase to align with existing `loanPurpose` /
// `productCategory` string data (scope-locked to four — Principle II).
// -----------------------------------------------------------------------------

/// The retail loan categories the platform sells (Principle II scope-lock, A26).
///
/// Every value is named by WHAT is financed. The no-payslip product is deliberately
/// NOT here: whether the bank reads a salary or works one out from a fact about the
/// applicant (army grade, academic rank, years in practice, card limit) is an income
/// BASIS, carried per program by `bank_program.programType`, and a personal or auto
/// loan is sold both ways by different banks. v15.0.0 tried it as a fifth value
/// (`fast`, "Fast Loans"); v16.0.0 removed it, because the questions a customer is
/// asked would then depend on a bank attribute the customer never chose.
///
/// A fifth value is a constitution amendment (A26), not a schema edit.
enum LoanCategory {
  personal
  car
  mortgage
  business
}

// Feature 010: all four values are renderable end to end. Only SINGLE_SELECT is
// scoreable — the approval formula needs one picked answer score per question,
// and any aggregate over multiple picks would be a new formula (A33 / R9).
enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  NUMERIC
}

enum ScoringWeightSetStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
  REJECTED
}

// Feature 010 — questions are GLOBAL (no category). A single question pool feeds
// one global questionnaire; per-program scoring picks which questions it uses via
// `ScoringWeightSet.weights.questionWeights` (checkbox = weight-set membership).
model QuestionGroup {
  id           String   @id @default(cuid()) @db.VarChar(30)
  code         String   @unique(map: "uniq_question_group_code") @db.VarChar(64)
  titleAr      String   @db.VarChar(160)
  titleEn      String   @db.VarChar(160)
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  questions Question[] @relation("QuestionGroupQuestions")

  @@index([displayOrder], name: "idx_question_group_order")
  @@map("question_group")
}

model Question {
  id           String       @id @default(cuid()) @db.VarChar(30)
  groupId      String       @db.VarChar(30)
  code         String       @unique(map: "uniq_question_code") @db.VarChar(64) // auto-generated slug, immutable, GLOBALLY unique
  type         QuestionType @default(SINGLE_SELECT)
  questionAr   String       @db.VarChar(500)
  questionEn   String       @db.VarChar(500)
  helperTextAr String?      @db.VarChar(500)
  helperTextEn String?      @db.VarChar(500)
  isRequired   Boolean      @default(true)
  displayOrder Int
  isActive     Boolean      @default(true)
  enabledWhen  Json? // { questionCode, operator: equals|not_equals, optionCode }

  // Feature 010 — per-type CONTENT rules (bounds, unit, length). Deliberately NOT
  // scoring or eligibility fields: A33 forbids those on Question/QuestionOption,
  // and which answer feeds which economic input is a code constant
  // (matching/pipeline/money-field-bindings.ts), never a column here.
  numericMinValue Decimal? @db.Decimal(18, 2) // NUMERIC only
  numericMaxValue Decimal? @db.Decimal(18, 2) // NUMERIC only; >= min
  numericStep     Decimal? @db.Decimal(18, 2) // NUMERIC only; > 0
  numericUnitAr   String?  @db.VarChar(24) // display unit, e.g. "جنيه"
  numericUnitEn   String?  @db.VarChar(24) // display unit, e.g. "EGP"
  textMaxLength   Int? // TEXT only; 1…2000

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  group          QuestionGroup                 @relation("QuestionGroupQuestions", fields: [groupId], references: [id], onDelete: Cascade)
  options        QuestionOption[]              @relation("QuestionOptions")
  answers        ApplicationAnswer[]           @relation("QuestionAnswers")
  loanCategories QuestionLoanCategory[]        @relation("QuestionLoanCategories")
  /// Catalog program names that suggest scoring on this question (template only).
  catalogNames   PlatformEnumerationQuestion[] @relation("QuestionPlatformEnumerations")
  /// Surrogate income FACTS answered by this question — registry rows, not a
  /// property of the question (see `PlatformEnumeration.boundQuestionId`).
  surrogateFacts PlatformEnumeration[]         @relation("QuestionSurrogateFactBindings")

  @@index([groupId, displayOrder], name: "idx_question_group_question_order")
  @@map("question")
}

// Which loan categories a GLOBAL-pool question is asked for. A join row, NOT a
// `category` column on `question` (A33): the pool stays one canonical list of
// questions and one question serves many categories. The assignment set is
// AUTHORITATIVE — a question with no rows here is asked for no category, so the
// admin's "assign" tab warns on an empty row and `createQuestion` seeds all four
// by default (nothing silently disappears from the wizard on create).
model QuestionLoanCategory {
  questionId String       @db.VarChar(30)
  category   LoanCategory
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  question Question @relation("QuestionLoanCategories", fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, category], name: "pk_question_loan_category")
  @@index([category], name: "idx_question_loan_category_category")
  @@map("question_loan_category")
}

model QuestionOption {
  id           String   @id @default(cuid()) @db.VarChar(30)
  questionId   String   @db.VarChar(30)
  code         String   @db.VarChar(64) // auto-generated slug, immutable
  labelAr      String   @db.VarChar(200)
  labelEn      String   @db.VarChar(200)
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  question Question @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, code], name: "uniq_question_option_question_code")
  @@index([questionId, displayOrder], name: "idx_question_option_question_order")
  @@map("question_option")
}

// Feature 010 — ONE global questionnaire (no category). Exactly one active
// version drives every applicant's questionnaire regardless of loan category.
model QuestionnaireVersion {
  id            String    @id @default(cuid()) @db.VarChar(30)
  versionNumber Int       @unique(map: "uniq_questionnaire_version_number")
  isActive      Boolean   @default(false) // exactly one active globally
  publishedAt   DateTime? @db.Timestamptz(6)
  publishedBy   String?   @db.VarChar(30) // staff id
  snapshot      Json // frozen groups+questions+options blob
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([isActive], name: "idx_questionnaire_version_active")
  @@map("questionnaire_version")
}

model ApplicationAnswer {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  applicationId       String   @db.VarChar(30)
  questionId          String   @db.VarChar(30)
  questionCode        String   @db.VarChar(64) // denormalised, stable across edits
  selectedOptionId    String?  @db.VarChar(30)
  selectedOptionCode  String?  @db.VarChar(64) // denormalised; single choice only
  // Feature 010 — canonical pick list for BOTH choice types; single choice writes
  // one element and still populates selectedOptionId/Code so the scorer and the
  // existing admin answer views keep working unchanged (FR-045 / R8). The
  // @@unique([applicationId, questionId]) below is what makes an array necessary.
  selectedOptionCodes String[] @default([])
  textValue           String?  @db.VarChar(2000) // TEXT answers; never logged (Principle VI)
  numericValue        Decimal? @db.Decimal(18, 2) // NUMERIC answers; source of the four money figures
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  application Application @relation("ApplicationDynamicAnswers", fields: [applicationId], references: [id], onDelete: Cascade)
  question    Question    @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, questionId], name: "uniq_application_answer_app_question")
  @@index([applicationId], name: "idx_application_answer_application")
  @@map("application_answer")
}

model ScoringWeightSet {
  id             String                 @id @default(cuid()) @db.VarChar(30)
  bankProgramId  String                 @db.VarChar(30)
  status         ScoringWeightSetStatus @default(DRAFT)
  versionNumber  Int
  weights        Json // v8: { questionWeights: {qCode→weight, sum 100}, answerScores: {qCode→oCode→score 0–100} }; legacy {qCode→oCode→points} upgraded on read
  createdBy      String                 @db.VarChar(30) // editor who saved (staff id)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  approvedBy     String?                @db.VarChar(30) // checker (staff id, != createdBy)
  approvedAt     DateTime?              @db.Timestamptz(6)
  rejectedReason String?                @db.VarChar(500)

  bankProgram BankProgram @relation("BankProgramScoringWeightSets", fields: [bankProgramId], references: [id], onDelete: Cascade)

  @@unique([bankProgramId, versionNumber], name: "uniq_scoring_weight_set_program_version")
  @@index([bankProgramId, status], name: "idx_scoring_weight_set_program_status")
  @@map("scoring_weight_set")
}
