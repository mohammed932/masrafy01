      <trans-unit id="approval.tier.low" datatype="html"><source>Low</source><target>منخفض</target></trans-unit>
      <trans-unit id="approval.tier.very_low" datatype="html"><source>Very low</source><target>منخفض جداً</target></trans-unit>
      <trans-unit id="approval.tier.no_match" datatype="html"><source>No matches yet</source><target>لا توجد مطابقات بعد</target></trans-unit>
      <trans-unit id="approval.pill.aria" datatype="html"><source>Approval probability <x id="INTERPOLATION"/>% — <x id="INTERPOLATION_1"/></source><target>احتمالية الموافقة <x id="INTERPOLATION"/>٪ — <x id="INTERPOLATION_1"/></target></trans-unit>
      <trans-unit id="sidebar.scoring_analytics" datatype="html"><source>Scoring analytics</source><target>تحليلات التقييم</target></trans-unit>
      <trans-unit id="analytics.title" datatype="html"><source>Scoring analytics</source><target>تحليلات التقييم</target></trans-unit>
      <trans-unit id="analytics.subtitle" datatype="html"><source>Distribution of approval scores over a chosen window plus per-tier accuracy against recorded bank decisions.</source><target>توزيع نتائج الاحتمالية ضمن نطاق زمني محدد بالإضافة إلى دقة كل فئة مقارنةً بقرارات البنوك المسجلة.</target></trans-unit>
      <trans-unit id="analytics.window.aria" datatype="html"><source>Select look-back window in days</source><target>اختر النطاق الزمني بالأيام</target></trans-unit>
      <trans-unit id="analytics.dist.title" datatype="html"><source>Distribution</source><target>التوزيع</target></trans-unit>
      <trans-unit id="analytics.dist.empty" datatype="html"><source>No matched offers in this window.</source><target>لا توجد عروض مطابقة في هذا النطاق.</target></trans-unit>
      <trans-unit id="analytics.dist.aria" datatype="html"><source>Approval score distribution histogram with 10 ten-point buckets</source><target>رسم بياني لتوزيع نتائج الاحتمالية مكوّن من 10 شرائح كل منها 10 نقاط</target></trans-unit>
      <trans-unit id="analytics.dist.tooltip" datatype="html"><source>Score <x id="INTERPOLATION"/>–<x id="INTERPOLATION_1"/>: <x id="INTERPOLATION_2"/> offers</source><target>نتيجة <x id="INTERPOLATION"/>–<x id="INTERPOLATION_1"/>: <x id="INTERPOLATION_2"/> عرض</target></trans-unit>
      <trans-unit id="analytics.tier.title" datatype="html"><source>Per-tier accuracy</source><target>الدقة لكل فئة</target></trans-unit>
      <trans-unit id="analytics.tier.col.tier" datatype="html"><source>Tier</source><target>الفئة</target></trans-unit>
      <trans-unit id="analytics.tier.col.offers" datatype="html"><source>Offers</source><target>عدد العروض</target></trans-unit>
      <trans-unit id="analytics.tier.col.decisions" datatype="html"><source>Decisions</source><target>عدد القرارات</target></trans-unit>
      <trans-unit id="analytics.tier.col.rate" datatype="html"><source>Approval rate</source><target>نسبة الموافقة</target></trans-unit>
      <trans-unit id="analytics.tier.rate.empty" datatype="html"><source>—</source><target>—</target></trans-unit>
      <trans-unit id="analytics.tier.rate.empty.tooltip" datatype="html"><source>Insufficient data for this tier in the selected window</source><target>لا توجد بيانات كافية لهذه الفئة في النطاق المحدد</target></trans-unit>
      <trans-unit id="analytics.error.title" datatype="html"><source>Out of OLTP range</source><target>النطاق خارج حدود قاعدة البيانات التشغيلية</target></trans-unit>
