      <trans-unit id="applications.detail.positive" datatype="html"><source>What helped</source><target>ما ساهم في رفع النتيجة</target></trans-unit>
      <trans-unit id="applications.detail.negative" datatype="html"><source>What hurt</source><target>ما خفّض النتيجة</target></trans-unit>
