# --- Database
DATABASE_URL=postgresql://masrafy:masrafy@localhost:5432/masrafy_dev?schema=public

# --- Redis
REDIS_URL=redis://localhost:6379

# --- JWT (admin API)
# Generate 32+ random bytes; e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_me_with_32_or_more_random_bytes_base64
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# --- Passwords
BCRYPT_COST=12

# --- HIBP (Pwned Passwords k-anonymity)
HIBP_BASE_URL=https://api.pwnedpasswords.com
HIBP_TIMEOUT_MS=1500

# --- Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Seed (bootstrap super_admin)
SEED_ADMIN_EMAIL=ops@masrafy.local
SEED_ADMIN_NAME=Operations
SEED_ADMIN_PASSWORD=ChangeMe_OnFirstLogin_!2026

# --- CORS (admin dashboard origins, comma-separated)
CORS_ORIGINS=http://localhost:4200

# --- App
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
