# ===========================================================================
# Masrafy admin — PRODUCTION env. Copy to `admin/.env` and fill the blanks.
#   cp .env.prod.example .env
# ===========================================================================

# Public subdomain for the admin dashboard (also the Let's Encrypt cert SAN).
HOST=admin.example.com

# Let's Encrypt registration email (same one used by the proxy).
LETSENCRYPT_EMAIL=ops@example.com
# Name of your EXISTING nginx-proxy docker network (must match exactly).
PROXY_NETWORK=web

# Backend API base URL baked into the SPA at BUILD time.
# Separate subdomains => absolute URL to the backend host + /api/admin.
# (Backend must list this admin origin in CORS_ORIGINS and set COOKIE_DOMAIN
#  to the shared root domain, e.g. .example.com.)
API_BASE_URL=https://api.example.com/api/admin
