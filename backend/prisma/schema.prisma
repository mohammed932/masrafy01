// Masrafy admin auth + user management.
// Constitution v1.0.0 Principles X, XI, XII apply.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum StaffRole {
  super_admin
  sales_manager
  sales_agent
  analyst
}

enum AttemptOutcome {
  SUCCESS
  WRONG_CREDENTIALS
  ACCOUNT_INACTIVE
  LOCKED_OUT
}

enum AuditEventType {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_TOKEN_REFRESHED
  AUTH_PASSWORD_CHANGED
  AUTH_PASSWORD_FORCED_CHANGE_COMPLETED
  ADMIN_USER_CREATED
  ADMIN_USER_UPDATED
  ADMIN_USER_DEACTIVATED
  ADMIN_USER_ROLE_CHANGED
  ADMIN_USER_PASSWORD_RESET
  BANK_PROGRAM_CREATED
  BANK_PROGRAM_UPDATED
  BANK_PROGRAM_TOGGLED
  BANK_PROGRAM_CLONED
  BANK_PROGRAM_DELETED
  BANK_PROGRAM_RATE_UPDATED
  BANK_PROGRAM_QUALITATIVE_REVIEW_DECIDED
  /// Feature 011 — a value-source marker was added or removed (FR-038). Also the
  /// source of `waitingSince` on the waiting list: "how long have we been waiting on
  /// this bank" is a question about WHEN the marker arrived, which only an event
  /// records (FR-036).
  BANK_PROGRAM_VALUE_SOURCE_CHANGED
  /// Feature 011 — a save introduced a team-estimated number on a LIVE program and
  /// switched it off in the same transaction (FR-035). Separate from an ordinary
  /// toggle so "why did this go dark?" names the paths and the editor.
  BANK_PROGRAM_DEACTIVATED_BY_ESTIMATE
  BANK_CREATED
  BANK_UPDATED
  BANK_TOGGLED
  BANK_DELETED
  BANK_LOGO_UPLOADED
  APPLICATION_CREATED
  APPLICATION_MATCHED
  APPLICATION_NO_MATCH
  APPLICATION_RATE_LIMITED
  MATCHING_ENGINE_RUN
  DATA_ERASURE_COMPLETED
  SCORING_ENGINE_VERSION_PROMOTED
  SCORING_WEIGHTS_SAVED
  APPLICATION_ACTIVITY_LOGGED
  DOCUMENT_UPLOADED
  APPLICATION_REASSIGNED
  MANAGER_ATTENTION_REQUESTED
  APPLICATION_LEAD_STATUS_CHANGED
  APPLICATION_USER_PROCEEDED
  PLATFORM_ENUMERATION_CREATED
  PLATFORM_ENUMERATION_UPDATED
  PLATFORM_ENUMERATION_DEACTIVATED
  PLATFORM_ENUMERATION_DEPRECATED
  /// A catalog entry was hard-DELETED (row gone, join rows cascaded). Distinct
  /// from DEPRECATED on purpose: deprecation is reversible and the row survives
  /// to explain old data, deletion leaves the audit event as the only remaining
  /// record that the key ever existed — so the payload carries the labels, not
  /// just the id.
  PLATFORM_ENUMERATION_DELETED
  // The KIND of list, not a value in one (`enumeration_type_def`). Separate values
  // rather than a payload flag: a reader filtering PLATFORM_ENUMERATION_CREATED and
  // reading `payload.type` would get a kind's key where it expected a value's type.
  ENUMERATION_TYPE_CREATED
  ENUMERATION_TYPE_UPDATED
  ENUMERATION_TYPE_DELETED
  CUSTOMER_SIGNED_UP
  CUSTOMER_LOGGED_IN
  CUSTOMER_LOGGED_OUT
  CUSTOMER_TOKEN_REFRESHED
  CUSTOMER_PASSWORD_CHANGED
  CUSTOMER_GUEST_APP_LINKED
  SUPPORT_REQUEST_CREATED
  SUPPORT_REQUEST_ASSIGNED
  SUPPORT_REQUEST_RESOLVED
  SUPPORT_CONFIG_UPDATED
  ONBOARDING_SCREEN_CREATED
  ONBOARDING_SCREEN_UPDATED
  ONBOARDING_SCREEN_DELETED
  ONBOARDING_SCREEN_REORDERED
  CATALOG_VIEWED
  QUESTIONNAIRE_STARTED
  OFFERS_VIEWED
  // --- Feature 008 (Constitution v1.8.0 / Principle XIII two-path registration) ---
  CUSTOMER_OTP_REQUESTED
  CUSTOMER_OTP_VERIFIED
  CUSTOMER_OTP_FAILED
  CUSTOMER_SIGNUP_PHONE_COMPLETED
  CUSTOMER_SIGNUP_SOCIAL_COMPLETED
  CUSTOMER_PROFILE_MOBILE_BOUND
  CUSTOMER_PROFILE_EMAIL_SET
  CUSTOMER_PROFILE_AGE_SET
  CUSTOMER_LOGIN_FAILED
  CUSTOMER_LOGIN_LOCKED
  CUSTOMER_TOKENS_REVOKED_OTHERS
  CUSTOMER_PASSWORD_RESET
  CUSTOMER_PROFILE_COMPLETED
  CUSTOMER_PROFILE_UPDATED
  APPLICATION_SUBMITTED
  // --- Admin-initiated customer account status (super_admin only) ---
  CUSTOMER_DEACTIVATED
  CUSTOMER_REACTIVATED
  // Admin revealed a customer PII document binary (National ID). Principle VI.
  CUSTOMER_DOCUMENT_REVEALED
  // --- RETIRED: no writer remains. Kept because `audit_event` rows are
  // append-only (Principle VI) and a Postgres enum value cannot be dropped in
  // place without recreating the type. Do not emit these.
  BANK_POLICY_UPDATED
  PROGRAM_CATALOG_DEFAULTS_UPDATED
}

enum SupportChannel {
  chat
  call
  whatsapp
  email
}

enum SupportStatus {
  open
  in_progress
  resolved
}

enum DecisionOutcome {
  approved
  rejected
  withdrawn
}

enum BankProgramType {
  income_proof
  income_surrogate
}

enum ApplicationStatus {
  draft
  matched
  no_match
  archived
  erased
}

// Sales-managed operational status of a lead (the applicant proceeded with an
// offer). Distinct from `ApplicationStatus` (engine matching outcome + data
// retention, system-set). Free-form transitions for MVP; default `pending`.
enum LeadStatus {
  pending
  in_progress
  done
  cancelled
}

enum ApplicationPriority {
  lowest_installment
  lowest_interest
  fastest_approval
  least_paperwork
}

// -----------------------------------------------------------------------------
// StaffAccount
// -----------------------------------------------------------------------------

model StaffAccount {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  email              String    @unique @db.VarChar(320)
  emailDisplay       String    @db.VarChar(320)
  name               String    @db.VarChar(120)
  passwordHash       String    @db.VarChar(72)
  role               StaffRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)
  lastLoginAt        DateTime? @db.Timestamptz(6)

  refreshTokens       RefreshToken[]
  signInAttempts      SignInAttempt[]
  auditEventsAsActor  AuditEvent[]    @relation("AuditEventActor")
  auditEventsAsTarget AuditEvent[]    @relation("AuditEventTarget")
  bankProgramsCreated BankProgram[]   @relation("BankProgramCreatedBy")
  bankProgramsUpdated BankProgram[]   @relation("BankProgramUpdatedBy")
  banksCreated        Bank[]          @relation("BankCreatedBy")
  banksUpdated        Bank[]          @relation("BankUpdatedBy")
  documentsUploaded   Document[]      @relation("DocumentUploader")
  documentsVerified   Document[]      @relation("DocumentVerifier")

  @@index([isActive, role], name: "idx_staff_account_active_role")
  @@map("staff_account")
}

// -----------------------------------------------------------------------------
// RefreshToken
// -----------------------------------------------------------------------------

model RefreshToken {
  id            String    @id @default(cuid()) @db.VarChar(30)
  userId        String    @db.VarChar(30)
  tokenHash     String    @unique @db.Char(64)
  issuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  rotatedFromId String?   @db.VarChar(30)
  userAgent     String?   @db.VarChar(500)
  sourceIp      String?   @db.Inet

  user        StaffAccount   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom RefreshToken?  @relation("RefreshTokenRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, revokedAt, expiresAt], name: "idx_refresh_token_user_active")
  @@map("refresh_token")
}

// -----------------------------------------------------------------------------
// SignInAttempt
// -----------------------------------------------------------------------------

model SignInAttempt {
  id             String         @id @default(cuid()) @db.VarChar(30)
  userId         String?        @db.VarChar(30)
  emailAttempted String         @db.VarChar(320)
  attemptedAt    DateTime       @default(now()) @db.Timestamptz(6)
  outcome        AttemptOutcome
  sourceIp       String         @db.Inet
  userAgent      String?        @db.VarChar(500)

  user StaffAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailAttempted, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_email_time")
  @@index([sourceIp, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_ip_time")
  @@index([userId, attemptedAt(sort: Desc)], name: "idx_sign_in_attempt_user_time")
  @@map("sign_in_attempt")
}

// -----------------------------------------------------------------------------
// AuditEvent
// -----------------------------------------------------------------------------

model AuditEvent {
  id            String         @id @default(cuid()) @db.VarChar(30)
  occurredAt    DateTime       @default(now()) @db.Timestamptz(6)
  actorId       String?        @db.VarChar(30)
  targetId      String?        @db.VarChar(30)
  bankProgramId String?        @db.VarChar(30)
  eventType     AuditEventType
  sourceIp      String?        @db.Inet
  payload       Json           @default("{}")

  actor       StaffAccount? @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  target      StaffAccount? @relation("AuditEventTarget", fields: [targetId], references: [id], onDelete: SetNull)
  bankProgram BankProgram?  @relation("BankProgramAuditEvents", fields: [bankProgramId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt(sort: Desc)], name: "idx_audit_event_actor_time")
  @@index([targetId, occurredAt(sort: Desc)], name: "idx_audit_event_target_time")
  @@index([bankProgramId, occurredAt(sort: Desc)], name: "idx_audit_event_bank_program_time")
  @@index([eventType, occurredAt(sort: Desc)], name: "idx_audit_event_type_time")
  @@map("audit_event")
}

// -----------------------------------------------------------------------------
// BankProgram (feature 002)
// -----------------------------------------------------------------------------

model BankProgram {
  id                String          @id @default(cuid()) @db.VarChar(30)
  programCode       String          @unique @db.VarChar(32)
  /// @deprecated — backfilled from `bank` relation; drop after v0.2.x release.
  bankName          String          @db.VarChar(80)
  bankId            String?         @db.VarChar(30)
  bank              Bank?           @relation(fields: [bankId], references: [id], onDelete: Restrict)
  friendlyName      String          @db.VarChar(120)
  friendlyNameAr    String?         @db.VarChar(120)
  /// Predefined program-name catalog key (`platform_enumeration` where
  /// `type = 'program_name'`). Nullable for legacy rows only — REQUIRED on every
  /// create/update through the API, which rejects unknown keys with
  /// `PROGRAM_NAME_KEY_UNKNOWN`. No FK: the catalog's unique key is the composite
  /// (type, key), so validation lives in the service layer like every other
  /// enumeration-backed field on this model.
  programNameKey    String?         @db.VarChar(64)
  programType       BankProgramType
  productCategory   String          @db.VarChar(64)
  active            Boolean         @default(true)
  isShariaCompliant Boolean         @default(false)
  version           Int             @default(1)
  operatorNotes     String?         @db.VarChar(4000)
  operatorTips      String[]        @db.VarChar(500)
  requiredDocuments String[]        @db.VarChar(80)

  // JSONB sub-configurations (research.md R1). Hydrated to typed values in repo layer.
  tenor               Json
  loanLimits          Json
  pricing             Json
  eligibility         Json
  performanceCriteria Json?
  incomeAssumption    Json
  fees                Json

  /// Feature 011 — sparse map of config dot-path → 'team_estimated'
  /// (`{"pricing.baseRatePercent": "team_estimated"}`).
  ///
  /// Only the NON-default state is stored: an ABSENT path is bank-stated. That is
  /// what lets every pre-existing program stay live on deploy (FR-037) — the
  /// default `{}` marks nothing estimated, so nothing goes dark. Storing both
  /// states would need a backfill over every numeric path of every program, and
  /// would make "a new field nobody has marked yet" indistinguishable from
  /// "estimated".
  ///
  /// Read on activation: a non-empty map refuses going live (FR-033). Never read
  /// by the matching engine — it is provenance about the configuration, not part
  /// of it.
  valueSources Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  createdBy String   @db.VarChar(30)
  updatedBy String   @db.VarChar(30)

  createdByStaff StaffAccount @relation("BankProgramCreatedBy", fields: [createdBy], references: [id])
  updatedByStaff StaffAccount @relation("BankProgramUpdatedBy", fields: [updatedBy], references: [id])
  auditEvents    AuditEvent[] @relation("BankProgramAuditEvents")

  @@index([active], name: "idx_bank_program_active")
  @@index([bankName], name: "idx_bank_program_bank_name")
  @@index([bankId], name: "idx_bank_program_bank_id")
  @@index([productCategory], name: "idx_bank_program_product_category")
  @@index([isShariaCompliant], name: "idx_bank_program_sharia")
  @@index([programNameKey], name: "idx_bank_program_program_name_key")
  @@map("bank_program")
}

// -----------------------------------------------------------------------------
// Bank — issuer entity managed by super_admin. BankPrograms link to Bank via FK.
// -----------------------------------------------------------------------------

model Bank {
  id           String   @id @default(cuid()) @db.VarChar(30)
  nameArabic   String   @db.VarChar(120)
  nameEnglish  String   @unique @db.VarChar(120)
  logoS3Key    String?  @db.VarChar(255)
  websiteUrl   String?  @db.VarChar(500)
  isActive     Boolean  @default(true)
  /// Phase-1 partner-bank flag. When true, the matching engine's `rankOffers`
  /// uses this as the final tiebreaker — identical primary-sort-key offers
  /// from featured banks rank first. Does NOT change eligibility or pricing.
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  notes        String?  @db.VarChar(2000)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  createdBy    String   @db.VarChar(30)
  updatedBy    String   @db.VarChar(30)

  createdByStaff StaffAccount  @relation("BankCreatedBy", fields: [createdBy], references: [id])
  updatedByStaff StaffAccount  @relation("BankUpdatedBy", fields: [updatedBy], references: [id])
  programs       BankProgram[]

  @@index([isActive, displayOrder], name: "idx_bank_active_order")
  @@index([isFeatured, isActive], name: "idx_bank_featured_active")
  @@map("bank")
}

// -----------------------------------------------------------------------------
// Application (feature 003 — matching engine)
// -----------------------------------------------------------------------------

model Application {
  id                      String              @id @default(cuid()) @db.VarChar(30)
  applicantUserId         String              @db.VarChar(30)
  submissionCorrelationId String              @db.VarChar(36)
  idempotencyKey          String?             @db.VarChar(128)
  payloadHash             String?             @db.Char(64)
  status                  ApplicationStatus   @default(draft)
  // Sales pipeline status — admin-managed, separate from engine `status`.
  leadStatus              LeadStatus          @default(pending)
  priority                ApplicationPriority
  requestedAmountEGP      Decimal             @db.Decimal(13, 2)
  preferredTenorMonths    Int
  loanPurpose             String              @db.VarChar(64)
  // Feature 00X — dynamic questionnaire: chosen category + the published
  // questionnaire version answered (snapshot reproducibility). Nullable until
  // the dynamic-questionnaire apply path replaces the legacy fixed-DTO path.
  category                LoanCategory?
  /// Catalog program-name archetype the applicant picked on top of the
  /// category (`platform_enumeration` where `type = 'program_name'`). The pair
  /// (category, programNameKey) is what narrowed the programs this application
  /// was matched against, so it is persisted: without it a stored application
  /// cannot explain why a program the customer can see in the catalog produced
  /// no offer. Nullable — legacy rows and any category-less submit carry none,
  /// and a null means "every program in the category", not "unknown".
  /// No FK, same posture as `bank_program.programNameKey`: the catalog's unique
  /// key is the composite (type, key), so validation lives in the service.
  programNameKey          String?             @db.VarChar(64)
  /// The income basis the applicant said they can prove, which narrowed the
  /// program set alongside the pair above. Persisted for the same reason:
  /// without it a stored application cannot explain why a program the customer
  /// can see in the catalog produced no offer. Nullable — every client built
  /// before the income-type step sends none, and a null means "both bases",
  /// not "unknown". Unlike `bank_program.programType` (NOT NULL) this is a
  /// REQUEST field, so the nullability is about client versions, not about
  /// programs being unclassified.
  programType             BankProgramType?
  questionnaireVersionId  String?             @db.VarChar(30)
  age                     Int
  applicantProfile        Json
  summary                 Json
  noMatchSummary          Json?
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  archivedAt              DateTime?           @db.Timestamptz(6)
  erasedAt                DateTime?           @db.Timestamptz(6)
  coldTierKey             String?             @db.VarChar(256)
  engineDurationMs        Int?
  programsCheckedCount    Int                 @default(0)
  eligibleProgramsCount   Int                 @default(0)

  // Feature 008 — user-intent gate: admin dashboard surfaces only applications
  // where the applicant explicitly selected a matched offer and proceeded.
  userSelectedBankOfferId String?   @db.VarChar(30)
  userProceededAt         DateTime? @db.Timestamptz(6)

  bankOffers            BankOffer[]           @relation("ApplicationBankOffers")
  userSelectedBankOffer BankOffer?            @relation("ApplicationUserSelectedOffer", fields: [userSelectedBankOfferId], references: [id], onDelete: SetNull)
  documents             Document[]            @relation("ApplicationDocuments")
  applicantCustomer     CustomerAccount       @relation("CustomerApplications", fields: [applicantUserId], references: [id], onDelete: Restrict)
  questionnaireAnswers  QuestionnaireAnswer[] @relation("QuestionnaireApplication")
  dynamicAnswers        ApplicationAnswer[]   @relation("ApplicationDynamicAnswers")

  @@unique([applicantUserId, idempotencyKey], name: "idx_application_idempotency")
  @@index([loanPurpose], name: "idx_application_purpose")
  @@index([leadStatus], name: "idx_application_lead_status")
  @@index([applicantUserId, createdAt(sort: Desc)], name: "idx_application_customer_created")
  @@index([userProceededAt(sort: Desc)], name: "idx_application_user_proceeded_at")
  @@map("application")
}

// -----------------------------------------------------------------------------
// BankOffer (feature 003 — immutable snapshot)
// -----------------------------------------------------------------------------

model BankOffer {
  id                      String    @id @default(cuid()) @db.VarChar(30)
  applicationId           String    @db.VarChar(30)
  programCode             String    @db.VarChar(32)
  programVersion          Int
  bankName                String    @db.VarChar(80)
  programFriendlyName     String    @db.VarChar(120)
  /// Snapshot of the owning bank's `isFeatured` at match time (Constitution
  /// Principle I — BankOffer is immutable; the partner-bank flag is frozen
  /// here so a bank toggling its featured state later doesn't rewrite
  /// history). Surfaced to mobile so the FEATURED chip never goes stale.
  bankIsFeatured          Boolean   @default(false)
  /// Snapshot of the program's Sharia-compliance flag at match time. Frozen on
  /// the offer for the same reason as `bankIsFeatured` (Principle I — BankOffer
  /// is immutable): a program later re-flagged must not rewrite past offers.
  isShariaCompliant       Boolean   @default(false)
  effectiveRatePercent    Decimal   @db.Decimal(7, 4)
  /// How that rate was charged — `reducing` (interest on the outstanding balance) or
  /// `flat` (interest on the original principal for the whole tenor).
  ///
  /// Frozen for the same reason `isShariaCompliant` is: a program re-priced onto the other
  /// basis later must not rewrite what this offer meant (Principle I / A6). The same rate
  /// over the same tenor buys 22-29% more loan reducing than flat, so the rate alone does
  /// not say what was quoted.
  ///
  /// `null` on every offer written before this column. Absent is NOT "flat": those offers
  /// were all priced by the reducing annuity, which is what `rateBasisOf` answers.
  rateBasis               String?   @db.VarChar(16)
  monthlyInstallmentEGP   Decimal   @db.Decimal(13, 2)
  requestedLoanAmountEGP  Decimal   @db.Decimal(13, 2)
  effectiveLoanAmountEGP  Decimal   @db.Decimal(13, 2)
  requestedTenorMonths    Int
  effectiveTenorMonths    Int
  feesBreakdown           Json
  /// The engine's own rank position for this offer, 0-based and dense within one
  /// application — the order the applicant was actually shown.
  ///
  /// `rankOffers` sorts by the key the applicant's own `priority` answer names, and
  /// every read used to throw that away: all of an application's offers are written in
  /// ONE transaction, so `createdAt` is identical across them and cannot rank anything.
  /// Frozen rather than re-derived (Principle I / A6) — the sort key depends on the
  /// profile, the priority and the whole candidate set at match time, and re-sorting an
  /// immutable offer set later rewrites what the customer saw.
  rankIndex               Int
  /// Which engine build priced this offer. Was the active `scoring_engine_version.version`;
  /// that registry existed only to version scoring weights and is gone, so the value now
  /// comes from `MATCHING_ENGINE_VERSION` in `src/matching/types.ts`.
  engineVersion           String    @db.VarChar(32)
  requiredDocuments       String[]  @db.VarChar(80)
  matchReasons            String[]  @db.VarChar(80)
  cascadeTrace            Json
  qualitativeReviewBadge  Boolean   @default(false)
  selfDeclared            Boolean   @default(false)
  /// The applicant's borrowing ceiling at this program, frozen at match time:
  /// income × dbrCapPercent ÷ 100 − obligations, present-valued over the tenor.
  /// Independent of what was requested — compare with `effectiveLoanAmountEGP`
  /// to tell "this is your limit" from "you asked for less than you could have".
  maxLoanAvailableEGP     Decimal?  @db.Decimal(13, 2)
  /// (installment + existing obligations) ÷ income × 100 for THIS offer, and the
  /// cap it was measured against (scalar or the resolved band). Frozen with the
  /// offer so a later policy change cannot rewrite why an amount was what it was.
  dbrPercent              Decimal?  @db.Decimal(6, 2)
  dbrCapPercent           Decimal?  @db.Decimal(7, 4)
  /// Feature 011 — WHICH income the quote actually ran on:
  /// `declared` · `surrogate` · `declared_over_surrogate` · `surrogate_over_declared`.
  ///
  /// Frozen at match time for the same reason `bankIsFeatured` and `rateBasis` are:
  /// editing the program's income rule later must not rewrite the meaning of an
  /// immutable offer (Principle I / A6). Deriving it at read time would rewrite
  /// history every time an admin fixed a table row.
  ///
  /// `null` means "recorded before provenance existed" — NOT `declared`. Readers
  /// must render the absence rather than assume a value.
  incomeOrigin            String?   @db.VarChar(32)
  /// The surrogate method that produced the income, when one did — the strategy
  /// token (`byMilitaryGrade`, …). `null` on a declared-income offer and on every
  /// offer predating this column.
  incomeSurrogateStrategy String?   @db.VarChar(32)
  /// The COLLATERAL CEILING a product rule derived for this applicant — what the unit,
  /// the membership or the vehicle supports, before their existing payments are taken off.
  ///
  /// Frozen for the same reason `incomeOrigin` is, and more sharply: the ceiling is the
  /// output of a step pipeline over a table, an uplift and the applicant's own answers, and
  /// every one of those can move. `maxLoanAvailableEGP` next to it is the figure AFTER
  /// obligations, so the pair is what lets a surface say "your unit supports 2 000 000, your
  /// existing payments leave 1 662 677" — where the second number alone reads as an
  /// unexplained cut (Principle I / A6).
  ///
  /// `null` on every offer of an income-based program, and on every offer predating this
  /// column. Absent is not zero: a zero ceiling would mean the collateral supports nothing.
  collateralCeilingEGP    Decimal?  @db.Decimal(13, 2)
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  erasedAt                DateTime? @db.Timestamptz(6)

  application            Application        @relation("ApplicationBankOffers", fields: [applicationId], references: [id], onDelete: Cascade)
  selectedByApplications Application[]      @relation("ApplicationUserSelectedOffer")
  decision               BankOfferDecision? @relation("BankOfferDecisionFor")
  savedBy                SavedOffer[]       @relation("BankOfferSavedBy")

  @@index([applicationId, rankIndex], name: "idx_bank_offer_application_rank")
  @@index([programCode, createdAt(sort: Desc)], name: "idx_bank_offer_program_created")
  @@index([engineVersion], name: "idx_bank_offer_engine_version")
  @@map("bank_offer")
}

// -----------------------------------------------------------------------------
// SavedOffer — a customer bookmarking a matched BankOffer ("Saved Offers"
// screen, Figma 4088-153). Pure link row: a customer ↔ an immutable BankOffer.
// All display fields are read from the related BankOffer (and its parent
// Application for the loan category) — nothing is duplicated here, so the
// BankOffer snapshot stays the single source of truth (Principle I).
// -----------------------------------------------------------------------------

model SavedOffer {
  id          String   @id @default(cuid()) @db.VarChar(30)
  customerId  String   @db.VarChar(30)
  bankOfferId String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  customer  CustomerAccount @relation("CustomerSavedOffers", fields: [customerId], references: [id], onDelete: Cascade)
  bankOffer BankOffer       @relation("BankOfferSavedBy", fields: [bankOfferId], references: [id], onDelete: Cascade)

  @@unique([customerId, bankOfferId], name: "idx_saved_offer_customer_offer")
  @@index([customerId, createdAt(sort: Desc)], name: "idx_saved_offer_customer_created")
  @@map("saved_offer")
}

