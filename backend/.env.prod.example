# ===========================================================================
# Masrafy backend — PRODUCTION env. Copy to `backend/.env` and fill the blanks.
#   cp .env.prod.example .env
# Generate secrets with:  openssl rand -base64 48
# ===========================================================================

# ---- Deploy / reverse proxy ----
# Public subdomain for the API (also the Let's Encrypt cert SAN).
HOST=api.example.com
# Let's Encrypt registration email (same one used by the proxy).
LETSENCRYPT_EMAIL=ops@example.com
# Name of your EXISTING nginx-proxy docker network (must match exactly).
PROXY_NETWORK=nginx-proxy

# ---- Postgres (compose `postgres` service) ----
POSTGRES_USER=masrafy
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=masrafy

# ---- App ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# NOTE: host = the compose service names, NOT localhost.
DATABASE_URL=postgresql://masrafy:CHANGE_ME_strong_db_password@postgres:5432/masrafy?schema=public
REDIS_URL=redis://redis:6379

# ---- Admin JWT ----
JWT_ACCESS_SECRET=CHANGE_ME_min_32_bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# ---- Customer (mobile) JWT — distinct secrets from admin ----
CUSTOMER_JWT_ACCESS_SECRET=CHANGE_ME_min_32_bytes_distinct
CUSTOMER_JWT_REFRESH_SECRET=CHANGE_ME_min_32_bytes_distinct_2
CUSTOMER_JWT_ACCESS_TTL_SECONDS=900
CUSTOMER_JWT_REFRESH_TTL_SECONDS=2592000

BCRYPT_COST=12

# ---- Cookies (refresh cookie shared across api.* and admin.* subdomains) ----
# Leading dot = valid for the whole root domain. Must be HTTPS in prod.
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true

# ---- CORS: admin dashboard origin(s), comma-separated, scheme included ----
CORS_ORIGINS=https://admin.masrafy.app

# ---- Bootstrap super_admin ----
# Set SEED_ON_START=true for the FIRST deploy to create the admin + questionnaire,
# then flip back to false. (Or run the seed manually — see DEPLOY.md.)
SEED_ON_START=false
SEED_ADMIN_EMAIL=ops@example.com
SEED_ADMIN_NAME=Operations
SEED_ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# ---- Mobile API rate limits ----
MOBILE_RATE_LIMIT_PER_CLIENT_PER_HOUR=30
MOBILE_RATE_LIMIT_PER_APPLICANT_PER_HOUR=5

# ---- S3 object storage ----
# DEFAULT = DigitalOcean Spaces (S3-compatible). Endpoint = REGION host only
# (no bucket); the SDK builds <bucket>.<region>.digitaloceanspaces.com because
# path-style is off. Get a key pair from DO → API → Spaces Keys.
S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=masrafy-storage
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_TTL_SECONDS=300
ADMIN_DOCUMENT_PRESIGNED_READ_TTL_SECONDS=3600
# AWS S3 alternative: S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com,
#   S3_REGION=<region>, IAM creds, S3_FORCE_PATH_STYLE=false.
# Self-hosted MinIO alternative (compose --profile storage). Public subdomain so
# presigned URLs resolve over SSL. When using MinIO set:
#   S3_ENDPOINT_URL=https://s3.example.com   and   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY become the MinIO root creds.
S3_HOST=s3.example.com

# ---- Auth providers / SMS ----
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_FROM=+201000000000
GOOGLE_OAUTH_CLIENT_IDS=replace_me.apps.googleusercontent.com
