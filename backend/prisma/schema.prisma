// -----------------------------------------------------------------------------
// PlatformEnumeration (feature 006) — operator-managed dropdown registry.
// Replaces the in-memory stub from feature 002 (research R4).
// Lifecycle: active=true is the only state shown in pickers; deprecatedAt
// flags a key that historical rows may still reference but new writes
// should reject. systemOnly=true blocks all CRUD except label edits.
// One table, many types: the columns below `sortOrder` are TYPE-SPECIFIC
// (`boundQuestionId` is `surrogate_fact` only; `surrogateProductKey` is
// `program_name` + `surrogate_fact`; `incomeRule` + `valueSources` are
// `surrogate_product` and `program_name`) and stay NULL / empty everywhere
// else. Which type may
// carry which is enforced in the service layer, not by a CHECK — the same
// posture `platform_enumeration_loan_category` already takes.
// -----------------------------------------------------------------------------

model PlatformEnumeration {
  id                  String    @id @default(cuid()) @db.VarChar(30)
  type                String    @db.VarChar(48)
  key                 String    @db.VarChar(64)
  labelAr             String    @db.VarChar(160)
  labelEn             String    @db.VarChar(160)
  active              Boolean   @default(true)
  deprecatedAt        DateTime? @db.Timestamptz(6)
  systemOnly          Boolean   @default(false)
  parentKey           String?   @db.VarChar(64)
  sortOrder           Int       @default(0)
  /// TWO types read this column, and they mean two different things by it.
  ///
  /// On a `program_name` — the `surrogate_product` row this catalog name takes its
  /// income calculation from. NULL = the name states its own rule in `incomeRule`
  /// (every payslip name, and every no-payslip name that predates the archetypes).
  ///
  /// On a `surrogate_fact` — the product that AUTHORED this fact. A fact is created
  /// inside a product's own screen along with the list and the question behind it,
  /// and this is what lets that screen ask "what did I make?" before there is a rule
  /// to derive the answer from. It is provenance, never a constraint: any product's
  /// rule may read any fact, exactly as before, and a fact with NULL here (the four
  /// builtins, and everything seeded) is readable by everyone.
  ///
  /// The two never collide — a row has one type — and both point at the same kind of
  /// row, so one column and one index serve both.
  ///
  /// NOT `parentKey`, and the three reasons are all load-bearing:
  ///   1. A type with a parent axis is REQUIRED to name one on create
  ///      (`ENUMERATION_PARENT_REQUIRED`), so `PARENT_TYPE_BY_TYPE.program_name`
  ///      would make every payslip catalog name uncreatable.
  ///   2. `enumerationParentKeys()` returns ONE flat, type-less `key → parentKey`
  ///      map, read by `factParentTable` in the engine AND by the fact registry's
  ///      parent-option walk. A `program_name` key colliding with a filed-under
  ///      value's key would silently hand that value a class.
  ///   3. The admin mirrors `PARENT_TYPE_BY_TYPE` client-side to decide whether to
  ///      render a required "Filed under" select — the catalog's own Add-name
  ///      dialog would grow one asking for a compound class.
  ///
  /// NO FOREIGN KEY, deliberately: the PK is `id` and the reachable unique is
  /// `(type, key)`, which a self-FK cannot express without a constant type column.
  /// Validated in the service layer against live `surrogate_product` keys, the same
  /// posture `parentKey` and `bank_program.programNameKey` already take.
  ///
  /// When set, the name's own `incomeRule` is NULL and `valueSources` is `{}` — a
  /// link that also kept a copy is not a link, it is a fork with nothing to reveal
  /// it. `programNameIncomeRules()` resolves the pointer; the save path refuses to
  /// create the both-present state and the migration RAISEs on it.
  surrogateProductKey String?   @db.VarChar(64)
  /// `surrogate_fact` only — the question whose ANSWER is this fact.
  ///
  /// The fact registry used to be a code constant
  /// (`matching/pipeline/surrogate-fact-bindings.ts`, four entries), which meant a
  /// bank that works income out from a fact nobody had foreseen — a taxi licence
  /// class, a clinic's patient count — needed a release. The four facts are now
  /// rows of `type = 'surrogate_fact'` and an operator adds a fifth on Manage
  /// values by picking the question that answers it.
  ///
  /// A COLUMN HERE, NOT A FIELD ON `question` — A33 forbids a scoring or
  /// profile-mapping field on `Question`, and this is the same binding
  /// `question_loan_category` is: it says what the REGISTRY reads, not what the
  /// question is. The question stays pure content.
  ///
  /// `ON DELETE SET NULL`, deliberately not cascade: a fact whose question left the
  /// pool is a fact that still has bank tables written against it, and the operator
  /// must see it unbound (publish warns `missing_or_inactive`) rather than watch the
  /// fact vanish and take every table's meaning with it.
  ///
  /// Only SINGLE_SELECT and NUMERIC questions may be bound (service-enforced): the
  /// first gives a key table, the second gives bands, and nothing else is a figure a
  /// bank can look an income up against.
  boundQuestionId     String?   @db.VarChar(30)
  /// `surrogate_product` and `program_name` — how a bank works a monthly income out
  /// for this product when there is no payslip to read. Same canonical shape
  /// `bank_program.incomeAssumption` carries: `{ strategy, keyTable?, bands?,
  /// scalar?, … }`, every figure a Decimal STRING (Principle I).
  ///
  /// ON THE ENUMERATION, NOT ON `platform_enumeration_loan_category`. Per-category
  /// keying looks like the finer grain and resolves none of the real conflicts:
  /// ABK's two `doctor` programs and its three `professional` programs are
  /// same-name, same-bank AND same-category, so a per-category rule would still
  /// have to hold two answers. Worse, it would not even be readable everywhere —
  /// six seeded programs carry `productCategory` values (`wealth`,
  /// `auto_cross_sell`, `credit_card_cross_sell`, `clubs`) that have NO row in
  /// that table at all, so the join returns nothing and the quote falls back to
  /// the declared salary WITHOUT saying it did. A rule that silently evaporates
  /// on a fifth of the catalog is worse than one stated once per name.
  ///
  /// ON A `surrogate_product` it is the archetype's own calculation, and the thing
  /// every linked catalog name quotes off. On a `program_name` it is the name's own
  /// rule, which is now the LEGACY half: a name that links to a product carries NULL
  /// here and reads the product's. Both columns are the same shape on purpose — the
  /// migration moves a rule between them by copying it, and `catalogIncomeRulePaths`
  /// keeps its `incomeRule.` root, so no value-source marker is re-rooted.
  ///
  /// NULLABLE, and the two empty-looking states are NOT the same:
  ///   NULL                       — nobody has decided. The name has no rule yet.
  ///                                (Or, on a `program_name`, it is LINKED — see
  ///                                `surrogateProductKey`; the two are told apart by
  ///                                that column, never by this one being empty.)
  ///   `{"strategy":"declared"}`  — an operator decided: this name is quoted off
  ///                                the income the applicant typed.
  /// Both quote identically; only the catalog counters and the operator screens
  /// read the difference, which is the whole point of storing the second
  /// explicitly instead of leaving it NULL.
  ///
  /// NAMED `incomeRule`, NOT `incomeAssumption`. The two live side by side for one
  /// release (`bank_program.incomeAssumption` stays the sole authority until the
  /// read moves), and a distinct name means a reference that did not get moved is
  /// a COMPILE ERROR rather than an `undefined` that quietly quotes a salary.
  ///
  /// Read UNCACHED on the quote path, same contract as `surrogateFactRegistry()`:
  /// a stale rule is a wrong income frozen onto a BankOffer that may never be
  /// rewritten (Principle I).
  incomeRule          Json?
  /// `surrogate_product` ONLY — the friendly form the operator filled in, from which
  /// `incomeRule` above was COMPILED. Shape: `ProductTemplate`
  /// (`matching/pipeline/product-template.ts`), `version` pinned so a future shape
  /// change is a migration rather than a silent re-read.
  ///
  /// TWO COLUMNS FOR ONE CALCULATION, and the split is the whole point. `incomeRule`
  /// stays the single artifact everything downstream reads — `effectiveProgramNameRule`,
  /// `effectiveIncomeRule`, the snapshot mapper, the engine — so NONE of them learns
  /// that a template exists. This column exists only so the form can be REOPENED and
  /// changed, instead of being a one-way generator whose output is then hand-edited.
  ///
  /// Both are written in ONE transaction. They cannot disagree, because the compile is
  /// the only writer of `incomeRule` on this path.
  ///
  /// NULL means "no template", and it is the ADVANCED state, not an empty one: a rule
  /// authored through the raw step editor sets this back to NULL, deliberately and
  /// one-way (`setSurrogateProductIncomeRule`). Pretending the two stay in sync after a
  /// hand edit is how a screen ends up describing a calculation that is not the one
  /// running.
  templateSpec        Json?
  /// `surrogate_product` ONLY — the AMOUNTS every new bank program starts its
  /// maximum-loan grid from. Shape: `{ "rows": MaxLoanByFactRow[] }`.
  ///
  /// AMOUNTS ONLY, never the axes. Which answer keys the rows, which keys the
  /// columns and what happens to an applicant with no row all come from the
  /// blueprint (`capShapeOf`), resolved at read time — so the grid and the figures
  /// in it cannot disagree about what a row means, and a shape change is a code
  /// change with a test behind it rather than a stale column.
  ///
  /// WHY IT IS COPIED AND NOT INHERITED. A bank program takes these numbers once,
  /// when it is created, and stores its own copy in `loanLimits.maxLoanByFact`.
  /// Editing them here later moves no program that has already saved — which is
  /// correct on a platform whose offers are immutable (Principle I / A6), and which
  /// is why this needs no `amounts: 'catalog' | 'own'` machinery of its own.
  ///
  /// NOT SEEDED. Every cap figure the source sheets publish is a NAMED bank's (App.
  /// A §2, §3 and §7 are ABK's), and three of the four banks selling the compound
  /// guarantee publish no unit-type cap at all — writing one bank's numbers here
  /// would hand the others a policy they never published (Principle II / A1). An
  /// operator types the default set on the product's own screen, exactly as they
  /// already type its income defaults.
  ///
  /// NULL = this product states no starting amounts, and a new program opens with
  /// the grid's rows in place and every box empty. That is the state every product
  /// ships in.
  capDefaults         Json?
  /// `surrogate_product` and `program_name` — estimated-value markers for the
  /// figures in `incomeRule`,
  /// the same sparse map `bank_program.valueSources` carries and with the same
  /// meaning: config dot-path → `'team_estimated'`, an ABSENT path is bank-stated.
  /// Paths are rooted at this column's own name
  /// (`{"incomeRule.keyTable.professor.incomeEGP":"team_estimated"}`), re-rooted
  /// from `incomeAssumption.` when a program's markers moved here.
  ///
  /// NOT NULL, defaulted `{}`: an absent map and an empty one would both mean
  /// "nothing estimated", and two spellings of one state is how a marker gets lost.
  /// Never read by the matching engine — it is provenance about the configuration,
  /// not part of it.
  ///
  /// Read by the admin rule screens only. NOT read on activation: that gate is
  /// `bank_program.valueSources`, and the claim that this column shares it was
  /// wrong when written — there has never been a reader of it on any activation
  /// path. Stated here because the wrong version of this comment is exactly the
  /// kind of thing the next person builds an enforcement on.
  valueSources        Json      @default("{}")
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)
  createdBy           String?   @db.VarChar(30)
  updatedBy           String?   @db.VarChar(30)

  loanCategories  PlatformEnumerationLoanCategory[] @relation("PlatformEnumerationLoanCategories")
  boundQuestion   Question?                         @relation("QuestionSurrogateFactBindings", fields: [boundQuestionId], references: [id], onDelete: SetNull)
  /// `surrogate_product` side of the ask set — which facts this product reads.
  asks            SurrogateProductAsk[]             @relation("SurrogateProductAsks")
  /// `surrogate_fact` side of the same rows — which products read this fact. This is
  /// the direction `surrogateProductKey` cannot express: it is one column, and a fact
  /// is legitimately read by several products.
  askedByProducts SurrogateProductAsk[]             @relation("SurrogateFactAskedBy")

  @@unique([type, key], name: "idx_platform_enumeration_type_key")
  @@index([type, active, sortOrder], name: "idx_platform_enumeration_type_active_sort")
  @@index([type, parentKey], name: "idx_platform_enumeration_type_parent")
  @@index([surrogateProductKey], name: "idx_platform_enumeration_surrogate_product")
  @@index([boundQuestionId], name: "idx_platform_enumeration_bound_question")
  @@map("platform_enumeration")
}

/// A KIND of list — the registry's own taxonomy, one row per `platform_enumeration.type`.
///
/// WHY THIS EXISTS. `platform_enumeration.type` was already de-facto data on the read path:
/// nothing validates the string on write (`CreateEnumerationDto.type` is a bare
/// `@Length(1,48)`), and `listTypeStats()` is a `GROUP BY type` over rows. What was welded
/// was every statement ABOUT a type — its parent axis, whether it may be deleted, and its
/// human label — each a separate hardcoded map, so inventing a list an operator could
/// actually use meant a release. A bank keying its cap table by a new set of classes is a
/// pricing decision, not a schema decision.
///
/// NOT A COLUMN ON `platform_enumeration`, and not a self-referential `type` row inside it:
/// a statement about the KIND would then have to be repeated on, and kept in step across,
/// every VALUE of that kind, with nothing to say which row was authoritative. `(type, key)`
/// is the value's unique; the kind's unique is `key` alone, which is a different table.
///
/// NO FOREIGN KEY from `platform_enumeration.type` to this table, deliberately — the same
/// posture `parentKey`, `surrogateProductKey` and `bank_program.programNameKey` all take.
/// A type is validated in the service layer, and the 14 builtin kinds predate this table:
/// an FK would make the migration that introduces it able to fail on real data.
///
/// `parentTypeKey` is the parent AXIS — "values of this kind are filed under a value of
/// that kind" — and is the data behind `parentTypeOf` / `childTypesOf`. It names a `key`
/// in this same table and carries no FK for the reason above.
///
/// `systemOnly` marks the 14 kinds the code still names in a constant or switches on
/// (`countReferences`, the customer allow-list, the categorised / question-bound / unscoped
/// axes). They may be relabelled and nothing else: renaming or deleting one would strand
/// every row that carries the string, and a code path would go on asking for it by name.
model EnumerationTypeDef {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  /// Matches `platform_enumeration.type`. Same 48-char budget, same key pattern.
  key                 String   @unique @db.VarChar(48)
  labelAr             String   @db.VarChar(160)
  labelEn             String   @db.VarChar(160)
  /// One line telling the operator what these values actually drive. Rail metadata, stored
  /// rather than hardcoded for the same reason the label is: a new kind has to say something.
  descriptionAr       String?  @db.VarChar(400)
  descriptionEn       String?  @db.VarChar(400)
  /// ng-zorro `nzType`. Not validated against the icon set — an unknown name renders the
  /// fallback, which is a blank tile rather than a broken screen.
  icon                String?  @db.VarChar(48)
  /// One realistic value, shown as the add-dialog's placeholder. A shared example is worse
  /// than none — under "Governorates", "e.g. Salaried employee" reads as an instruction.
  exampleAr           String?  @db.VarChar(160)
  exampleEn           String?  @db.VarChar(160)
  /// The kind whose values these are filed under, by `key`. NULL = no parent axis, and a
  /// stray `parentKey` on a value of this kind is refused rather than force-nulled.
  parentTypeKey       String?  @db.VarChar(48)
  /// Where a value of this kind goes when an operator UNFILES it — the answer to "not that
  /// class", never a default for a class nobody named.
  ///
  /// Names a `key` in the `parentTypeKey` list, and carries NO FK for the reason the whole
  /// table states above. NULL is the ordinary state and means today's behaviour exactly:
  /// `POST parent-keys` with `null` stores `null`, the value is unfiled, and `factParentTable`
  /// answers `no_matching_row` for whoever picked it.
  ///
  /// On the CHILD kind, not the parent: it answers "where do THIS kind's unfiled values go?",
  /// and one parent list can be the axis of two child kinds that want different answers.
  ///
  /// Read by `resolveParentKey` under `allowUnfiled` and by nothing else. Deliberately NOT
  /// read on CREATE: a blank class on a pasted row is a typo, not a decision, and the platform
  /// choosing a price tier on the operator's behalf is what `ENUMERATION_PARENT_REQUIRED`
  /// exists to refuse.
  fallbackParentKey   String?  @db.VarChar(64)
  /// Whether a value of this kind may be hard-deleted. Replaces `DELETABLE_TYPES`.
  deletable           Boolean  @default(false)
  /// Whether this kind appears on the operator's Manage-values rail. Replaces `LOOKUP_TYPES`.
  /// Off for kinds that have a screen of their own (`program_name`, `surrogate_product`).
  onValuesRail        Boolean  @default(true)
  /// A builtin the code names by string. Relabelling is allowed; rename and delete are not.
  systemOnly          Boolean  @default(false)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0)
  /// The `surrogate_product` that authored this kind of list, by `key`. NULL = a shared
  /// list nobody owns (all 14 builtins, and anything made on the Manage-values rail).
  ///
  /// Set by the product screen, which is the only place a list can be created ALONGSIDE
  /// the question that asks it. It answers "which lists did this product make?" — a
  /// question the coverage derivation (`attachOptionsEnumerationType`) cannot answer for
  /// a product that has no rule yet, because there is nothing to derive from. Once the
  /// rule exists both answers are available and they say the same thing; the derivation
  /// stays the authority for what the rule READS, this stays the authority for what the
  /// product MADE. Ownership grants nothing and forbids nothing: any rule may read any
  /// list, and `onValuesRail` — not this column — is what keeps an owned list off the
  /// global rail.
  ///
  /// No FK, for the reason the whole table states above: the reachable unique on the
  /// product is `(type, key)` and a self-FK cannot express a constant type column.
  surrogateProductKey String?  @db.VarChar(48)
  /// The question whose OPTIONS are this list, one-for-one, `question_option.code` ===
  /// `platform_enumeration.key`.
  ///
  /// That equality is not a convention, it is what makes the whole chain work: the
  /// engine's `factChoiceTable` / `factParentTable` look a bank's table up by the option
  /// code the customer picked, and `attachOptionsEnumerationType` recognises which list a
  /// question draws on by covering its option codes with a type's keys. The seed has
  /// always guaranteed it (`seed-questionnaire.ts#enumOptions`); nothing else could,
  /// because the admin option API mints codes by slugifying a label.
  ///
  /// So the link is STORED rather than derived, and it is stored on the LIST rather than
  /// on the question: the sync runs when a VALUE is written, and a value write knows its
  /// type and nothing else. Derived coverage cannot serve here either — the moment an
  /// operator adds the tenth value, coverage is broken and there is nothing left to read
  /// the link off. NULL = a list no question mirrors (every builtin; a list read only by
  /// a bank's own key table).
  ///
  /// `ON DELETE SET NULL`: a question removed from the pool leaves the list standing with
  /// its values intact — the same posture `boundQuestionId` takes, and for the same
  /// reason (bank tables are written against those keys).
  mirrorQuestionId    String?  @db.VarChar(30)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  createdBy           String?  @db.VarChar(30)
  updatedBy           String?  @db.VarChar(30)

  mirrorQuestion Question? @relation("QuestionMirroredEnumerationTypes", fields: [mirrorQuestionId], references: [id], onDelete: SetNull)

  @@index([active, sortOrder], name: "idx_enumeration_type_def_active_sort")
  @@index([parentTypeKey], name: "idx_enumeration_type_def_parent")
  @@index([surrogateProductKey], name: "idx_enumeration_type_def_surrogate_product")
  @@index([mirrorQuestionId], name: "idx_enumeration_type_def_mirror_question")
  @@map("enumeration_type_def")
}

/// Which loan categories a catalog entry may be OFFERED under.
///
/// A join row, not a column: one `program_name` archetype ("Pharmacy") serves
/// several categories, and the `categories[]` array this replaces
/// (`20260802090000_drop_program_name_categories`) could be neither indexed nor
/// audited per pair, and shipped with no backfill — so narrowing it silently
/// hid valid picks in the bank-program builder. Here the set is AUTHORITATIVE:
/// an entry with no rows is "parked" (offerable nowhere), and bank-program
/// create/update/duplicate reject an unassigned (programNameKey,
/// productCategory) pair.
///
/// Generic by shape, meaningful only for the types in
/// `CATEGORISED_ENUMERATION_TYPES`. The service layer — not a CHECK constraint —
/// keeps a `governorate` row from acquiring a loan category, the same posture
/// `bank_program.programNameKey` already takes (no FK, validated in the service).
///
/// Orthogonal to `parentKey`, which stays NULL for `program_name`
/// (`20260807090000_clear_program_name_parent_key`): that column is the
/// registry's generic single-parent SCOPE, this is a many-to-many ASSIGNMENT.
/// No income-basis columns here (dropped in `20260816090000_drop_program_name_income_basis`).
/// v16.1.0 stored `payslip` / `noPayslip` per pair and the API refused a program whose
/// own basis was not ticked. That made the catalog a SECOND place to state one thing the
/// bank already states on its program (`bank_program.programType`), and the two could
/// disagree — with the catalog winning, so a bank's own choice was refused by a tick set
/// on another screen. The program is now the only authority; the catalog SHOWS what banks
/// picked, counted from `bank_program`, and enforces nothing.
model PlatformEnumerationLoanCategory {
  enumerationId String       @db.VarChar(30)
  category      LoanCategory
  /// How income is proved when this name is sold under this category — the
  /// INCOME BASIS, stored per (name, category) pair.
  ///
  /// Two booleans rather than one enum because a name legitimately carries BOTH:
  /// one bank sells "Doctor Loans" against a payslip while another works the
  /// income out from years in practice, and v16.0.0 deleted the `fast` category
  /// precisely because that pair is one product, not two. A single-valued column
  /// would force the second bank to duplicate the catalog entry.
  ///
  /// This is the operator's INTENT for the name — what the catalog says the name is
  /// for. It does NOT refuse a bank program: `bank_program.programType` is the only
  /// authority on how one bank actually sells it, and the catalog reports that split
  /// separately (`countProgramNameUsage.byCategory`). The two answer different
  /// questions and are allowed to disagree — a name marked payslip-only that a bank
  /// then sells without one is a signal to look, not a save to block.
  ///
  /// Both false is meaningless (a pair offerable under no basis is unsellable) and
  /// is rejected in the service, the same posture this table already takes for
  /// "only `program_name` may be categorised".
  payslip       Boolean      @default(true)
  noPayslip     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)

  enumeration PlatformEnumeration @relation("PlatformEnumerationLoanCategories", fields: [enumerationId], references: [id], onDelete: Cascade)

  @@id([enumerationId, category], name: "pk_platform_enumeration_loan_category")
  @@index([category], name: "idx_platform_enumeration_loan_category_category")
  @@map("platform_enumeration_loan_category")
}

/// WHICH FACTS A NO-PAYSLIP PRODUCT READS — the product's ask set, first class.
///
/// WHY A TABLE AND NOT `platform_enumeration.surrogateProductKey`. That column is one
/// column and it means AUTHORSHIP ("provenance, never a constraint", see its own comment
/// above). Membership is many-to-many and the planner withholds the column in two cases
/// on purpose (`blueprint-plan.ts`): for a fact several blueprints share, because a
/// cascade would kill one product's axis when another product went away, and for every
/// cap-only blueprint, which builds no product row for a fact to be filed under. Both
/// were measured, and both had the same visible consequence — `club_branch_cap`, a
/// product whose entire content is one ask, rendered "asks the applicant nothing yet",
/// and `school_type`, read by three blueprints, appeared on nobody's list.
///
/// So authorship and membership are two relations and they get two homes. This one is
/// authoritative for what step ① of a product's screen lists; the column keeps saying
/// who made the row.
///
/// IDs WITH REAL FOREIGN KEYS on both ends, unlike `surrogateProductKey`, whose
/// reachable unique is the composite `(type, key)` that a self-FK cannot name. Both ends
/// address `platform_enumeration.id`, which IS the primary key, so referential integrity
/// is available here and is taken: an allowed fact delete takes its ask rows with it
/// instead of leaving the ghost rows A26 forbids.
///
/// `source` is STORED, not derived. The blueprint seed must be able to re-assert its own
/// ask on every deploy without claiming an operator made it, and the card renders it as
/// provenance — "comes with the product" — beside the question's own label.
///
/// `detachedAt` is the TOMBSTONE, and it is what makes an operator's untick of a
/// blueprint-owned ask survive a deploy. The seed's insert is idempotent by primary key,
/// so a row that is still here — detached — is a row the seed writes nothing over: the
/// removal stands until somebody ticks the card again, which clears the column. Deleting
/// the row instead would leave the seed nothing to collide with and the ask would silently
/// come back on the next `npm run seed:blueprints`, which is the whole reason the untick
/// used to be refused. An `operator` ask carries no tombstone — nothing re-asserts it, so
/// its untick is a plain delete.
///
/// NOT keyed by loan category. What a product READS is one decision; which loan types
/// ASK the question behind it is `question_loan_category`, which is global to the question
/// and shared with every other reader of it. A per-category ask set would be a second,
/// quieter statement of the same thing, free to disagree with the questionnaire about
/// what an applicant is actually asked.
model SurrogateProductAsk {
  /// `platform_enumeration.id` of the `surrogate_product` row.
  productId  String             @db.VarChar(30)
  /// `platform_enumeration.id` of the `surrogate_fact` row.
  factId     String             @db.VarChar(30)
  source     SurrogateAskSource
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  createdBy  String?            @db.VarChar(30)
  /// Set when an operator unticked a `blueprint` ask. NULL = the product reads the fact.
  /// Every read of the ask set filters on it; the blueprint seed does not, which is what
  /// stops a re-seed reviving what an operator removed.
  detachedAt DateTime?          @db.Timestamptz(6)
  detachedBy String?            @db.VarChar(30)

  product PlatformEnumeration @relation("SurrogateProductAsks", fields: [productId], references: [id], onDelete: Cascade)
  fact    PlatformEnumeration @relation("SurrogateFactAskedBy", fields: [factId], references: [id], onDelete: Cascade)

  /// `productId` leads so a product's own board (its whole ask set) is a prefix scan;
  /// the reverse index carries "who else reads this fact", which is what the untick
  /// refusal and the shared-fact notice on the card both read.
  @@id([productId, factId], name: "pk_surrogate_product_ask")
  @@index([factId], name: "idx_surrogate_product_ask_fact")
  @@map("surrogate_product_ask")
}

/// Who put an ask on a product. `blueprint` is the predefined library's own statement of
/// what its product reads and is re-asserted by `npm run seed:blueprints`; `operator` is
/// a pick made on the product's screen. Either can be removed there — a `blueprint` ask
/// is tombstoned rather than deleted, so the seed cannot put it back.
enum SurrogateAskSource {
  blueprint
  operator
}

// -----------------------------------------------------------------------------
// CustomerAccount (v1.7.0 / Principle XIII customer-facing mobile auth).
// Distinct from StaffAccount — end-users of the Flutter app sign up with
// phone (unique) + password and receive a customer JWT.
// -----------------------------------------------------------------------------

// Feature 008 — Two-Path Registration (Constitution v1.8.0 / Principle XIII).
// `registrationPath` distinguishes upfront-PHONE customers (fully populated at
// signup) from lite-SOCIAL customers (provider sign-in; mobile + age completed
// via the loan-request Complete-Profile flow). `passwordHash` is nullable so
// SOCIAL customers (who authenticate via Google) need not carry one.
// `mobileVerifiedAt` flips non-null IFF `phone` is OTP-verified — once set,
// both fields are immutable (enforced by repository, not the DB). `age` is
// nullable for in-flight SOCIAL customers; set immutably on first successful
// loan submission.
enum RegistrationPath {
  PHONE
  SOCIAL
}

// Constitution v11.0.0 — Google is the only social provider. `APPLE` was
// dropped from this enum by `google_only_social_provider`; the enum type itself
// is kept single-valued because it keys two tables and is where a future
// provider would be added.
enum SocialProvider {
  GOOGLE
}

enum OtpPurpose {
  SIGNUP
  PROFILE_MOBILE
  FORGOT_PASSWORD
  MOBILE_CHANGE
}

model CustomerAccount {
  id                   String           @id @default(cuid()) @db.VarChar(30)
  registrationPath     RegistrationPath @default(PHONE)
  phone                String?          @unique @db.VarChar(20)
  mobileVerifiedAt     DateTime?        @db.Timestamptz(6)
  email                String?          @unique @db.VarChar(320)
  firstName            String           @db.VarChar(60)
  lastName             String           @db.VarChar(60)
  nameSplitNeedsReview Boolean          @default(false)
  locale               String           @default("ar-EG") @db.VarChar(8)
  passwordHash         String?          @db.VarChar(72)
  birthday             DateTime?        @db.Date
  profilePhotoKey      String?          @db.VarChar(256)
  nationalIdHash       String?          @db.Char(64)
  governorate          String?          @db.VarChar(60)
  city                 String?          @db.VarChar(120)
  address              String?          @db.VarChar(255)
  isVerified           Boolean          @default(false)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)
  lastLoginAt          DateTime?        @db.Timestamptz(6)

  refreshTokens     CustomerRefreshToken[]
  applications      Application[]          @relation("CustomerApplications")
  uploadedDocuments Document[]             @relation("DocumentCustomerUploader")
  idDocuments       Document[]             @relation("DocumentCustomerOwner")
  supportRequests   SupportRequest[]       @relation("SupportRequestCustomer")
  providers         CustomerProvider[]
  passwordResets    PasswordResetToken[]
  questionnaires    QuestionnaireAnswer[]
  savedOffers       SavedOffer[]           @relation("CustomerSavedOffers")

  // Postgres UNIQUE allows multiple NULLs by default, so `phone @unique`
  // works fine for SOCIAL customers whose phone is still null pending the
  // Complete-Profile flow.
  @@index([isActive, createdAt(sort: Desc)], name: "idx_customer_account_active_created")
  @@index([registrationPath], name: "idx_customer_account_registration_path")
  @@map("customer_account")
}

model CustomerRefreshToken {
  id            String    @id @default(cuid()) @db.VarChar(30)
  customerId    String    @db.VarChar(30)
  tokenHash     String    @unique @db.Char(64)
  issuedAt      DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  rotatedFromId String?   @db.VarChar(30)
  userAgent     String?   @db.VarChar(500)
  sourceIp      String?   @db.Inet

  customer    CustomerAccount        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rotatedFrom CustomerRefreshToken?  @relation("CustomerRefreshTokenRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   CustomerRefreshToken[] @relation("CustomerRefreshTokenRotation")

  @@index([customerId, revokedAt, expiresAt], name: "idx_customer_refresh_token_active")
  @@map("customer_refresh_token")
}

// -----------------------------------------------------------------------------
// Feature 008 — Two-Path Registration tables (Constitution v1.8.0 / Principle XIII).
// -----------------------------------------------------------------------------

// One row per (customer, provider) link. Provider+providerUserId is the unique
// natural key — the Google subject ID. Email is captured at link time so a
// provider that later withholds it cannot orphan the account.
model CustomerProvider {
  id             String         @id @default(cuid()) @db.VarChar(30)
  customerId     String         @db.VarChar(30)
  provider       SocialProvider
  providerUserId String         @db.VarChar(255)
  email          String?        @db.VarChar(320)
  linkedAt       DateTime       @default(now()) @db.Timestamptz(6)

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([customerId], name: "idx_customer_provider_customer")
  @@map("customer_provider")
}

// OTP challenges. `customerId` is null for SIGNUP / FORGOT_PASSWORD (pre-
// customer-link) and set for PROFILE_MOBILE (SOCIAL Complete-Profile mobile
// binding). codeHash is bcrypt cost 10. Never logged.
model OtpChallenge {
  id           String     @id @default(cuid()) @db.VarChar(30)
  customerId   String?    @db.VarChar(30)
  phone        String     @db.VarChar(20)
  purpose      OtpPurpose
  codeHash     String     @db.VarChar(72)
  attemptsLeft Int        @default(5)
  expiresAt    DateTime   @db.Timestamptz(6)
  consumedAt   DateTime?  @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, expiresAt], name: "idx_otp_challenge_active")
  @@index([customerId, expiresAt], name: "idx_otp_challenge_customer")
  @@map("otp_challenge")
}

// Single-use, 15-min-TTL bearer proving an OTP-verified phone in the PHONE
// signup flow. Consumed by /auth/signup/phone/complete. SOCIAL Complete-
// Profile uses the customer's JWT instead (the customer record already exists).
model VerifiedMobileToken {
  id         String    @id @default(cuid()) @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  phone      String    @db.VarChar(20)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone, expiresAt], name: "idx_verified_mobile_token_phone")
  @@map("verified_mobile_token")
}

// Short-lived (15 min) wrapper around a successful Google ID-token
// verification. Consumed by /auth/social/login (returning customer) or the
// social-signup transaction (new customer + CustomerProvider link).
model SocialSession {
  id                 String         @id @default(cuid()) @db.VarChar(30)
  provider           SocialProvider
  providerUserId     String         @db.VarChar(255)
  email              String?        @db.VarChar(320)
  fullName           String?        @db.VarChar(120)
  resolvedCustomerId String?        @db.VarChar(30)
  expiresAt          DateTime       @db.Timestamptz(6)
  consumedAt         DateTime?      @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)

  @@index([provider, providerUserId], name: "idx_social_session_subject")
  @@map("social_session")
}

// Single-use, 15-min-TTL token issued after a successful forgot-password OTP.
// PHONE customers only. Consumed by /auth/password/reset.
model PasswordResetToken {
  id         String    @id @default(cuid()) @db.VarChar(30)
  customerId String    @db.VarChar(30)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt], name: "idx_password_reset_token_active")
  @@map("password_reset_token")
}

// Server-side persisted questionnaire draft per customer. Survives across
// devices (FR-007). One active "draft" row per customer; on loan-application
// submit, `applicationId` is set to freeze the snapshot at submission time.
// (Field set kept narrow here — additional questionnaire fields will be added
// when the existing questionnaire feature is migrated server-side.)
model QuestionnaireAnswer {
  id            String   @id @default(cuid()) @db.VarChar(30)
  customerId    String   @db.VarChar(30)
  applicationId String?  @db.VarChar(30)
  payloadJson   Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  customer    CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  application Application?    @relation("QuestionnaireApplication", fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([customerId], name: "idx_questionnaire_answer_customer")
  @@index([applicationId], name: "idx_questionnaire_answer_application")
  @@map("questionnaire_answer")
}

// -----------------------------------------------------------------------------
// Support (PR #5) — singleton config + customer-initiated requests.
// -----------------------------------------------------------------------------

model SupportConfig {
  id          String   @id @default("singleton") @db.VarChar(16)
  phone       String   @db.VarChar(40)
  email       String   @db.VarChar(320)
  whatsappUrl String   @db.VarChar(500)
  hoursAr     String   @db.VarChar(200)
  hoursEn     String   @db.VarChar(200)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedBy   String?  @db.VarChar(30)

  @@map("support_config")
}

model SupportRequest {
  id              String         @id @default(cuid()) @db.VarChar(30)
  applicationId   String?        @db.VarChar(30)
  customerId      String?        @db.VarChar(30)
  channel         SupportChannel
  note            String?        @db.VarChar(2000)
  status          SupportStatus  @default(open)
  assignedStaffId String?        @db.VarChar(30)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt      DateTime?      @db.Timestamptz(6)

  customer CustomerAccount? @relation("SupportRequestCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)], name: "idx_support_request_status_created")
  @@index([assignedStaffId, status], name: "idx_support_request_agent_status")
  @@index([applicationId], name: "idx_support_request_application")
  @@map("support_request")
}

// -----------------------------------------------------------------------------
// OnboardingScreen (PR #6) — mobile first-launch screens (2-3 items).
// Admin-editable; mobile reads via HMAC.
// -----------------------------------------------------------------------------

model OnboardingScreen {
  id         String   @id @default(cuid()) @db.VarChar(30)
  order      Int      @unique
  titleAr    String   @db.VarChar(200)
  titleEn    String   @db.VarChar(200)
  bodyAr     String   @db.VarChar(2000)
  bodyEn     String   @db.VarChar(2000)
  imageS3Key String?  @db.VarChar(255)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  updatedBy  String?  @db.VarChar(30)

  @@index([active, order], name: "idx_onboarding_screen_active_order")
  @@map("onboarding_screen")
}

// -----------------------------------------------------------------------------
// Feature 00X — Dynamic Questionnaire & Matching (Constitution V v4.1.0).
// Questions/options/branching/ordering are admin-editable DATA; the engine that
// consumes them stays in code. (v25.0.0: there are no per-bank scoring weights —
// approval scoring was removed platform-wide.)
// LoanCategory values are lowercase to align with existing `loanPurpose` /
// `productCategory` string data (scope-locked to four — Principle II).
// -----------------------------------------------------------------------------

/// The retail loan categories the platform sells (Principle II scope-lock, A26).
///
/// Every value is named by WHAT is financed. The no-payslip product is deliberately
/// NOT here: whether the bank reads a salary or works one out from a fact about the
/// applicant (army grade, academic rank, years in practice, card limit) is an income
/// BASIS, carried per program by `bank_program.programType`, and a personal or auto
/// loan is sold both ways by different banks. v15.0.0 tried it as a fifth value
/// (`fast`, "Fast Loans"); v16.0.0 removed it, because the questions a customer is
/// asked would then depend on a bank attribute the customer never chose.
///
/// A fifth value is a constitution amendment (A26), not a schema edit.
enum LoanCategory {
  personal
  car
  mortgage
  business
}

// Feature 010: all four values are renderable end to end. Only SINGLE_SELECT is
// scoreable — the approval formula needs one picked answer score per question,
// and any aggregate over multiple picks would be a new formula (A33 / R9).
enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  NUMERIC
}

// Feature 010 — questions are GLOBAL (no category). A single question pool feeds
// one global questionnaire, narrowed per applicant by `question_loan_category`.
//
// NOTE (v25.0.0): this used to add "per-program scoring picks which questions it uses
// via `ScoringWeightSet.weights.questionWeights`". Both authorities named there are
// gone — approval scoring with its weight sets, and the advisory
// `platform_enumeration_question` template that pre-ticked its wizard. What a
// no-payslip product READS is `surrogate_product_ask`, which the engine actually
// consults; nothing else selects a subset of the pool per program.
model QuestionGroup {
  id           String   @id @default(cuid()) @db.VarChar(30)
  code         String   @unique(map: "uniq_question_group_code") @db.VarChar(64)
  titleAr      String   @db.VarChar(160)
  titleEn      String   @db.VarChar(160)
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  questions Question[] @relation("QuestionGroupQuestions")

  @@index([displayOrder], name: "idx_question_group_order")
  @@map("question_group")
}

model Question {
  id           String       @id @default(cuid()) @db.VarChar(30)
  groupId      String       @db.VarChar(30)
  code         String       @unique(map: "uniq_question_code") @db.VarChar(64) // auto-generated slug, immutable, GLOBALLY unique
  type         QuestionType @default(SINGLE_SELECT)
  questionAr   String       @db.VarChar(500)
  questionEn   String       @db.VarChar(500)
  helperTextAr String?      @db.VarChar(500)
  helperTextEn String?      @db.VarChar(500)
  isRequired   Boolean      @default(true)
  displayOrder Int
  isActive     Boolean      @default(true)
  enabledWhen  Json? // { questionCode, operator: equals|not_equals, optionCode }

  // Feature 010 — per-type CONTENT rules (bounds, unit, length). Deliberately NOT
  // scoring or eligibility fields: A33 forbids those on Question/QuestionOption,
  // and which answer feeds which economic input is a code constant
  // (matching/pipeline/money-field-bindings.ts), never a column here.
  numericMinValue Decimal? @db.Decimal(18, 2) // NUMERIC only
  numericMaxValue Decimal? @db.Decimal(18, 2) // NUMERIC only; >= min
  numericStep     Decimal? @db.Decimal(18, 2) // NUMERIC only; > 0
  numericUnitAr   String?  @db.VarChar(24) // display unit, e.g. "جنيه"
  numericUnitEn   String?  @db.VarChar(24) // display unit, e.g. "EGP"
  textMaxLength   Int? // TEXT only; 1…2000

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  group          QuestionGroup          @relation("QuestionGroupQuestions", fields: [groupId], references: [id], onDelete: Cascade)
  options        QuestionOption[]       @relation("QuestionOptions")
  answers        ApplicationAnswer[]    @relation("QuestionAnswers")
  loanCategories QuestionLoanCategory[] @relation("QuestionLoanCategories")
  /// Surrogate income FACTS answered by this question — registry rows, not a
  /// property of the question (see `PlatformEnumeration.boundQuestionId`).
  surrogateFacts PlatformEnumeration[]  @relation("QuestionSurrogateFactBindings")
  /// Lists whose values ARE this question's options, one-for-one by code. Again a
  /// statement the REGISTRY makes about itself, not a field on the question
  /// (see `EnumerationTypeDef.mirrorQuestionId`).
  mirroredLists  EnumerationTypeDef[]   @relation("QuestionMirroredEnumerationTypes")

  @@index([groupId, displayOrder], name: "idx_question_group_question_order")
  @@map("question")
}

// Which loan categories a GLOBAL-pool question is asked for. A join row, NOT a
// `category` column on `question` (A33): the pool stays one canonical list of
// questions and one question serves many categories. The assignment set is
// AUTHORITATIVE — a question with no rows here is asked for no category, so the
// admin's "assign" tab warns on an empty row and `createQuestion` seeds all four
// by default (nothing silently disappears from the wizard on create).
model QuestionLoanCategory {
  questionId String       @db.VarChar(30)
  category   LoanCategory
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)

  question Question @relation("QuestionLoanCategories", fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, category], name: "pk_question_loan_category")
  @@index([category], name: "idx_question_loan_category_category")
  @@map("question_loan_category")
}

model QuestionOption {
  id           String   @id @default(cuid()) @db.VarChar(30)
  questionId   String   @db.VarChar(30)
  code         String   @db.VarChar(64) // auto-generated slug, immutable
  labelAr      String   @db.VarChar(200)
  labelEn      String   @db.VarChar(200)
  displayOrder Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  question Question @relation("QuestionOptions", fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, code], name: "uniq_question_option_question_code")
  @@index([questionId, displayOrder], name: "idx_question_option_question_order")
  @@map("question_option")
}

// Feature 010 — ONE global questionnaire (no category). Exactly one active
// version drives every applicant's questionnaire regardless of loan category.
model QuestionnaireVersion {
  id            String    @id @default(cuid()) @db.VarChar(30)
  versionNumber Int       @unique(map: "uniq_questionnaire_version_number")
  isActive      Boolean   @default(false) // exactly one active globally
  publishedAt   DateTime? @db.Timestamptz(6)
  publishedBy   String?   @db.VarChar(30) // staff id
  snapshot      Json // frozen groups+questions+options blob
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([isActive], name: "idx_questionnaire_version_active")
  @@map("questionnaire_version")
}

model ApplicationAnswer {
  id                  String   @id @default(cuid()) @db.VarChar(30)
  applicationId       String   @db.VarChar(30)
  questionId          String   @db.VarChar(30)
  questionCode        String   @db.VarChar(64) // denormalised, stable across edits
  selectedOptionId    String?  @db.VarChar(30)
  selectedOptionCode  String?  @db.VarChar(64) // denormalised; single choice only
  // Feature 010 — canonical pick list for BOTH choice types; single choice writes
  // one element and still populates selectedOptionId/Code so the scorer and the
  // existing admin answer views keep working unchanged (FR-045 / R8). The
  // @@unique([applicationId, questionId]) below is what makes an array necessary.
  selectedOptionCodes String[] @default([])
  textValue           String?  @db.VarChar(2000) // TEXT answers; never logged (Principle VI)
  numericValue        Decimal? @db.Decimal(18, 2) // NUMERIC answers; source of the four money figures
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  application Application @relation("ApplicationDynamicAnswers", fields: [applicationId], references: [id], onDelete: Cascade)
  question    Question    @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([applicationId, questionId], name: "uniq_application_answer_app_question")
  @@index([applicationId], name: "idx_application_answer_application")
  @@map("application_answer")
}
