import { describe, expect, it } from 'vitest';
import { quoteProgram } from '../../src/matching/pipeline/quote';
import { profileFixture, programFixture } from '../helpers/matching';

function q(o: any) { if (!o.ok) throw new Error(o.unavailable.reason); return o.quote; }

describe('refutation probe', () => {
  it('A: reviewer fixture — override 36 vs preferred 84 (DIVERGENT, direct call only)', () => {
    const program = programFixture({
      tenor: { minMonths: 12, maxMonths: 120 },
      pricing: { baseRatePercent: '27.0000', rateByTenor: { '12': { ratePercent: '27.0000' }, '60': { ratePercent: '27.0000' }, '84': { ratePercent: '29.0000' } } },
    } as any);
    const out = q(quoteProgram({
      profile: profileFixture({ preferredTenorMonths: 84 }),
      program,
      overrideTenorMonths: 36,
      skipDbrCheck: true,
    } as any));
    console.log('A rate=', out.effectiveRatePercent.toString(), 'tenor=', out.effectiveTenorMonths);
  });

  it('B: calculator-realistic — override === preferred (36/36)', () => {
    const program = programFixture({
      tenor: { minMonths: 12, maxMonths: 120 },
      pricing: { baseRatePercent: '27.0000', rateByTenor: { '12': { ratePercent: '27.0000' }, '60': { ratePercent: '27.0000' }, '84': { ratePercent: '29.0000' } } },
    } as any);
    const out = q(quoteProgram({
      profile: profileFixture({ preferredTenorMonths: 36 }),
      program,
      overrideTenorMonths: 36,
      skipDbrCheck: true,
    } as any));
    console.log('B rate=', out.effectiveRatePercent.toString(), 'tenor=', out.effectiveTenorMonths);
  });

  it('C: apply/preview path — no override, preferred 84, clamp to 60', () => {
    const program = programFixture({
      tenor: { minMonths: 12, maxMonths: 60 },
      pricing: { baseRatePercent: '27.0000', rateByTenor: { '12': { ratePercent: '27.0000' }, '60': { ratePercent: '27.0000' }, '84': { ratePercent: '29.0000' } } },
    } as any);
    const out = q(quoteProgram({
      profile: profileFixture({ preferredTenorMonths: 84 }),
      program,
      skipDbrCheck: true,
    } as any));
    console.log('C rate=', out.effectiveRatePercent.toString(), 'tenor=', out.effectiveTenorMonths);
  });
});
