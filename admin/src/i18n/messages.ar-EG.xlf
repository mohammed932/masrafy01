      <trans-unit id="applications.detail.deprecatedBadge" datatype="html"><source>Deprecated</source><target>متوقف</target></trans-unit>
      <trans-unit id="applications.detail.deprecatedTooltip" datatype="html"><source>Deprecated in v<x id="INTERPOLATION"/></source><target>متوقف في الإصدار <x id="INTERPOLATION"/></target></trans-unit>
      <trans-unit id="applications.detail.deprecatedGeneric" datatype="html"><source>Deprecated in the active engine</source><target>متوقف في الإصدار النشط للمحرك</target></trans-unit>
      <trans-unit id="applications.detail.scoredUnder" datatype="html"><source>Scored under engine v<x id="INTERPOLATION"/></source><target>تم التقييم بإصدار المحرك v<x id="INTERPOLATION"/></target></trans-unit>
